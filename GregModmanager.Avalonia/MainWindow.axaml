<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GregModmanager.Avalonia.ViewModels"
        x:Class="GregModmanager.Avalonia.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1400"
        Height="900"
        MinWidth="1024"
        MinHeight="640"
        Background="{DynamicResource Surface}"
        SystemDecorations="None"
        Title="gregModmanager">

  <Grid RowDefinitions="42,*" ColumnDefinitions="240,*">
    <Border Grid.Row="0" Grid.ColumnSpan="2" Classes="titlebar" PointerPressed="OnTitleBarPointerPressed">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center" Spacing="8">
          <Border Width="18" Height="18" CornerRadius="2" Classes="accent-box" />
          <TextBlock Classes="micro-label" Text="GREGMODMANAGER // TERMINAL CORE" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,4,6,4" Spacing="4">
          <Button Width="34" Height="28" Classes="window-btn" Content="—" Click="OnMinimizeClicked" />
          <Button Width="34" Height="28" Classes="window-btn close" Content="✕" Click="OnCloseClicked" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1" Grid.Column="0" Classes="sidebar">
      <Grid RowDefinitions="Auto,*,Auto" Margin="10,14,10,10">
        <StackPanel Spacing="6" x:Name="NavPanel">
          <TextBlock Text="WORKSHOP" Classes="micro-label" />
          <Button Classes="nav-item active" Content="Projects" Click="OnNavProjects" x:Name="BtnProjects" />
          <Button Classes="nav-item" Content="New Project" Click="OnNavNewProject" x:Name="BtnNewProject" />
          <Button Classes="nav-item" Content="My Uploads" Click="OnNavMyUploads" x:Name="BtnMyUploads" />
          <Button Classes="nav-item" Content="Mod Store" Click="OnNavModStore" x:Name="BtnModStore" IsVisible="False" />
          <TextBlock Text="SYSTEM" Classes="micro-label" Margin="0,12,0,0" />
          <Button Classes="nav-item" Content="Settings" Click="OnNavSettings" x:Name="BtnSettings" />
        </StackPanel>
        <StackPanel Grid.Row="2" Spacing="8">
          <Border Classes="status-chip">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Ellipse Width="8" Height="8" x:Name="SteamStatusLed" />
              <TextBlock x:Name="SteamStatusText" Classes="chip-text" Text="Steam Disconnected" />
            </StackPanel>
          </Border>
          <Border Classes="status-chip">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Ellipse Width="8" Height="8" x:Name="GregApiStatusLed" />
              <TextBlock x:Name="GregApiStatusText" Classes="chip-text" Text="gregAPI Offline" />
            </StackPanel>
          </Border>
          <Border Classes="status-chip">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Ellipse Width="8" Height="8" x:Name="AuthStatusLed" />
              <TextBlock x:Name="AuthStatusText" Classes="chip-text" Text="Login To Datacentermods.com" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <ContentControl Grid.Row="1" Grid.Column="1" x:Name="MainContent" Margin="0" />
  </Grid>
</Window>
