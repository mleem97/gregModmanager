{
  "name": "greg modmanager (rust, slint)",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "vscode",
  "containerEnv": {
    "CARGO_TERM_COLOR": "always",
    "RUSTUP_TOOLCHAIN": "stable"
  },
  "customizations": {
    "vscode": {
      "extensions": ["rust-lang.rust-analyzer"]
    }
  },
  "postCreateCommand": "rustup component add rust-analyzer && cargo fetch"
}
