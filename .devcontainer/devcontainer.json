{
  "name": "greg modmanager (avalonia, net10)",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "vscode",
  "containerEnv": {
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
    "DOTNET_NOLOGO": "1"
  },
  "mounts": [
    "source=greg-modmanager-nuget,target=/home/vscode/.nuget/packages,type=volume"
  ],
  "customizations": {
    "vscode": {
      "extensions": ["ms-dotnettools.csharp"]
    }
  },
  "postCreateCommand": "dotnet restore GregModmanager.sln"
}
