import { LineEdit } from "std-widgets.slint";
import { ScrollView } from "std-widgets.slint";
import { IconSet } from "@lucide";
import { Palette, SectionTitle, Thumb, GregButton, ListCard } from "theme.slint";
import { LocalRow } from "models.slint";

// Local content page (My Mods / My Plugins / My Libs). One component, the
// title and rows differ per kind. Enable/disable renames .dll files,
// removal goes through the shell confirm dialog.
//
// The list is split into Active / Disabled sections. Each section is a
// fixed-frame card (`vertical-stretch` + `min-height`) with its own
// internal `ScrollView`, so long mod lists scroll inside their box instead
// of growing past the window.
export component LocalPage inherits VerticalLayout {
    in-out property <string> title;
    in-out property <string> search;
    in-out property <[LocalRow]> active-rows;
    in-out property <[LocalRow]> inactive-rows;
    in-out property <string> status;

    callback refresh();
    callback toggle(int);
    callback remove(int);
    callback open-folder();

    spacing: 8px;
    padding: 18px;

    SectionTitle { text: root.title; }

    // Fixed height: bare input/button rows balloon vertically otherwise.
    Rectangle {
        height: 36px;
        HorizontalLayout {
            width: parent.width;
            height: parent.height;
            spacing: 8px;
            alignment: center;
            LineEdit {
                text <=> root.search;
                placeholder-text: "Filter…";
                horizontal-stretch: 1;
            }
            GregButton {
                text: "Rescan";
                has-icon: true;
                icon: IconSet.RefreshCw;
                clicked => { root.refresh(); }
            }
            GregButton {
                text: "Open folder";
                has-icon: true;
                icon: IconSet.FolderOpen;
                clicked => { root.open-folder(); }
            }
        }
    }


    SectionTitle { text: "ACTIVE (" + root.active-rows.length + ")"; }
    ListCard {
        vertical-stretch: 1;
        min-height: 140px;
        ScrollView {
            width: parent.width;
            height: parent.height;
            VerticalLayout {
                padding: 6px;
                spacing: 2px;
                if root.active-rows.length == 0: Text {
                    text: "No active entries.";
                    font-size: 12px;
                    color: Palette.on-variant;
                    horizontal-alignment: center;
                }
                for row in root.active-rows: Rectangle {
                    height: 44px;
                    background: Palette.container;
                    border-radius: Palette.radius-lg;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 8px;
                        spacing: 8px;
                        Thumb {
                            src: row.thumb;
                            y: (parent.height - self.height) / 2;
                        }
                        Rectangle {
                            width: 8px;
                            height: 8px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 4px;
                            background: Palette.secondary;
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            Text {
                                text: row.name;
                                font-size: 12px;
                                font-weight: 700;
                                color: Palette.on-surface;
                                overflow: elide;
                            }
                            Text {
                                text: row.detail;
                                font-size: 10px;
                                color: Palette.on-variant;
                                overflow: elide;
                            }
                        }
                        GregButton {
                            text: "Disable";
                            has-icon: true;
                            icon: IconSet.Power;
                            clicked => { root.toggle(row.index); }
                        }
                        GregButton {
                            text: "Remove";
                            has-icon: true;
                            icon: IconSet.Trash2;
                            variant: "danger";
                            clicked => { root.remove(row.index); }
                        }
                    }
                }
            }
        }
    }

    SectionTitle { text: "DISABLED (" + root.inactive-rows.length + ")"; }
    ListCard {
        vertical-stretch: 1;
        min-height: 110px;
        ScrollView {
            width: parent.width;
            height: parent.height;
            VerticalLayout {
                padding: 6px;
                spacing: 2px;
                if root.inactive-rows.length == 0: Text {
                    text: "No disabled entries.";
                    font-size: 12px;
                    color: Palette.on-variant;
                    horizontal-alignment: center;
                }
                for row in root.inactive-rows: Rectangle {
                    height: 44px;
                    background: Palette.container;
                    border-radius: Palette.radius-lg;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 8px;
                        spacing: 8px;
                        Thumb {
                            src: row.thumb;
                            y: (parent.height - self.height) / 2;
                        }
                        Rectangle {
                            width: 8px;
                            height: 8px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 4px;
                            background: Palette.outline;
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            Text {
                                text: row.name;
                                font-size: 12px;
                                font-weight: 700;
                                color: Palette.on-variant;
                                overflow: elide;
                            }
                            Text {
                                text: row.detail;
                                font-size: 10px;
                                color: Palette.on-variant;
                                overflow: elide;
                            }
                        }
                        GregButton {
                            text: "Enable";
                            has-icon: true;
                            icon: IconSet.Power;
                            variant: "primary";
                            clicked => { root.toggle(row.index); }
                        }
                        GregButton {
                            text: "Remove";
                            has-icon: true;
                            icon: IconSet.Trash2;
                            variant: "danger";
                            clicked => { root.remove(row.index); }
                        }
                    }
                }
            }
        }
    }
}
