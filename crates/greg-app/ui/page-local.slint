import { LineEdit } from "std-widgets.slint";
import { ScrollView } from "std-widgets.slint";
import { IconSet } from "@lucide";
import { Palette, SectionTitle, Thumb, GregButton, ListCard } from "theme.slint";
import { LocalRow } from "models.slint";
import { Tr } from "i18n.slint";

// Local content page (My Mods / My Plugins / My Libs). One component, the
// title and rows differ per kind. Enable/disable renames .dll files,
// removal goes through the shell confirm dialog.
//
// The list is split into Active / Disabled sections. Each section is a
// fixed-frame card (`vertical-stretch` + `min-height`) with its own
// internal `ScrollView`, so long mod lists scroll inside their box instead
// of growing past the window.
export component LocalPage inherits VerticalLayout {
    in-out property <string> title;
    in-out property <string> search;
    in-out property <[LocalRow]> active-rows;
    in-out property <[LocalRow]> inactive-rows;
    in-out property <string> status;
    in property <bool> is-libs: false;
    in property <bool> is-plugins: false;

    callback refresh();
    callback toggle(int);
    callback remove(int);
    callback open-folder();
    callback open-lib-modal();
    callback open-plugin-modal();
    callback install-plugins();

    spacing: 8px;
    padding: 18px;

    SectionTitle { text: root.title; }

    // Fixed height: bare input/button rows balloon vertically otherwise.
    Rectangle {
        height: 36px;
        HorizontalLayout {
            width: parent.width;
            height: parent.height;
            spacing: 8px;
            alignment: center;
            LineEdit {
                text <=> root.search;
                placeholder-text: Tr.local-filter-placeholder;
                horizontal-stretch: 1;
                edited(_) => { root.refresh(); }
            }
            if root.is-libs: GregButton {
                text: Tr.local-install-libs;
                has-icon: true;
                icon: IconSet.Plus;
                variant: "primary";
                clicked => { root.open-lib-modal(); }
            }
            if root.is-plugins: GregButton {
                text: Tr.local-browse-plugins;
                has-icon: true;
                icon: IconSet.Search;
                clicked => { root.open-plugin-modal(); }
            }
            if root.is-plugins: GregButton {
                text: Tr.local-install-plugins;
                has-icon: true;
                icon: IconSet.Plus;
                variant: "primary";
                clicked => { root.install-plugins(); }
            }
            GregButton {
                text: Tr.local-rescan;
                has-icon: true;
                icon: IconSet.RefreshCw;
                clicked => { root.refresh(); }
            }
            GregButton {
                text: Tr.local-open-folder;
                has-icon: true;
                icon: IconSet.FolderOpen;
                clicked => { root.open-folder(); }
            }
        }
    }


    SectionTitle { text: Tr.local-active-section + " (" + root.active-rows.length + ")"; }
    ListCard {
        vertical-stretch: 1;
        min-height: 140px;
        ScrollView {
            width: parent.width;
            height: parent.height;
            VerticalLayout {
                padding: 6px;
                spacing: 2px;
                if root.active-rows.length == 0: Text {
                    text: Tr.local-no-active;
                    font-size: 12px;
                    color: Palette.on-variant;
                    horizontal-alignment: center;
                }
                for row in root.active-rows: Rectangle {
                    height: 44px;
                    background: Palette.container;
                    border-radius: Palette.radius-lg;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 8px;
                        spacing: 8px;
                        Thumb {
                            src: row.thumb;
                            y: (parent.height - self.height) / 2;
                        }
                        Rectangle {
                            width: 8px;
                            height: 8px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 4px;
                            background: Palette.secondary;
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            min-width: 0px;
                            alignment: center;
                            Text {
                                text: row.name;
                                font-size: 12px;
                                font-weight: 700;
                                color: Palette.on-surface;
                                overflow: elide;
                            }
                            Text {
                                text: row.detail;
                                font-size: 10px;
                                color: Palette.on-variant;
                                overflow: elide;
                            }
                        }
                        GregButton {
                            text: Tr.local-disable;
                            has-icon: true;
                            icon: IconSet.Power;
                            clicked => { root.toggle(row.index); }
                        }
                        GregButton {
                            text: Tr.local-remove;
                            has-icon: true;
                            icon: IconSet.Trash2;
                            variant: "danger";
                            clicked => { root.remove(row.index); }
                        }
                    }
                }
            }
        }
    }

    SectionTitle { text: Tr.local-disabled-section + " (" + root.inactive-rows.length + ")"; }
    ListCard {
        vertical-stretch: 1;
        min-height: 110px;
        ScrollView {
            width: parent.width;
            height: parent.height;
            VerticalLayout {
                padding: 6px;
                spacing: 2px;
                if root.inactive-rows.length == 0: Text {
                    text: Tr.local-no-disabled;
                    font-size: 12px;
                    color: Palette.on-variant;
                    horizontal-alignment: center;
                }
                for row in root.inactive-rows: Rectangle {
                    height: 44px;
                    background: Palette.container;
                    border-radius: Palette.radius-lg;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 8px;
                        spacing: 8px;
                        Thumb {
                            src: row.thumb;
                            y: (parent.height - self.height) / 2;
                        }
                        Rectangle {
                            width: 8px;
                            height: 8px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 4px;
                            background: Palette.outline;
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            min-width: 0px;
                            alignment: center;
                            Text {
                                text: row.name;
                                font-size: 12px;
                                font-weight: 700;
                                color: Palette.on-variant;
                                overflow: elide;
                            }
                            Text {
                                text: row.detail;
                                font-size: 10px;
                                color: Palette.on-variant;
                                overflow: elide;
                            }
                        }
                        GregButton {
                            text: Tr.local-enable;
                            has-icon: true;
                            icon: IconSet.Power;
                            variant: "primary";
                            clicked => { root.toggle(row.index); }
                        }
                        GregButton {
                            text: Tr.local-remove;
                            has-icon: true;
                            icon: IconSet.Trash2;
                            variant: "danger";
                            clicked => { root.remove(row.index); }
                        }
                    }
                }
            }
        }
    }

    Text {
        text: root.status;
        font-size: 11px;
        color: Palette.on-variant;
        overflow: elide;
    }
}
