import { LineEdit, TextEdit, ComboBox, CheckBox, ProgressIndicator } from "std-widgets.slint";
import { IconSet } from "@lucide";
import { Palette, SectionTitle, FieldRow, GregButton, ListCard } from "theme.slint";
import { AppIcon } from "icons.slint";
import { CheckRow } from "models.slint";
import { Tr } from "i18n.slint";

export component EditorPage inherits VerticalLayout {
    in-out property <string> title;
    in-out property <string> version;
    in-out property <string> desc;
    in-out property <string> tags;
    in-out property <int> visibility;
    in-out property <[string]> visibilities;
    in-out property <int> profile;
    in-out property <[string]> profiles;
    in-out property <int> modtype;
    in-out property <[string]> modtypes;
    in-out property <bool> needs-greg;
    in-out property <bool> needs-ml;
    in-out property <string> changelog;
    in-out property <string> changelog-hint;
    in-out property <string> desc-hint;
    in-out property <string> fileid-text;
    in property <string> project-name;
    in-out property <[CheckRow]> checks;
    in-out property <bool> ready;
    in-out property <string> readiness-text;
    in-out property <[string]> deps;
    in-out property <string> dep-add-text;
    in-out property <string> preview-text;
    // Empty when no preview file is set.
    in-out property <image> preview-image;
    in-out property <[string]> shots;
    in-out property <float> progress;
    in-out property <bool> publishing;
    in-out property <string> status;
    in-out property <[string]> log;

    callback changed();
    callback save();
    callback publish();
    callback publish-modstore();
    callback cancel-publish();
    callback pick-preview();
    callback add-shot();
    callback remove-shot(int);
    callback dep-add();
    callback dep-remove(int);
    callback view-on-steam();

    spacing: 8px;
    padding: 18px;

    Flickable {
        vertical-stretch: 1;
        VerticalLayout {
            spacing: 8px;

            SectionTitle { text: Tr.editor-section-details; }

            FieldRow {
                label: Tr.editor-title;
                title-box := LineEdit {
                    text <=> root.title;
                    horizontal-stretch: 1;
                    edited(_) => { root.changed(); }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                Text {
                    width: 130px;
                    text: Tr.editor-version;
                    font-size: 12px;
                    color: Palette.on-variant;
                    vertical-alignment: center;
                }
                LineEdit {
                    text <=> root.version;
                    edited(_) => { root.changed(); }
                }
                Text {
                    text: root.fileid-text;
                    font-size: 11px;
                    color: Palette.on-variant;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                if root.fileid-text != "": GregButton {
                    text: Tr.editor-view-on-steam;
                    has-icon: true;
                    icon: IconSet.ExternalLink;
                    clicked => { root.view-on-steam(); }
                }
            }

            Text {
                text: Tr.editor-description;
                font-size: 12px;
                color: Palette.on-variant;
            }
            TextEdit {
                text <=> root.desc;
                height: 120px;
                edited(_) => { root.changed(); }
            }
            Text {
                text: root.desc-hint;
                font-size: 11px;
                color: Palette.on-variant;
            }

            FieldRow {
                label: Tr.editor-tags;
                LineEdit {
                    text <=> root.tags;
                    horizontal-stretch: 1;
                    edited(_) => { root.changed(); }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                Text {
                    width: 130px;
                    text: Tr.editor-visibility;
                    font-size: 12px;
                    color: Palette.on-variant;
                    vertical-alignment: center;
                }
                ComboBox {
                    model: root.visibilities;
                    current-index <=> root.visibility;
                }
                Text {
                    text: Tr.editor-profile;
                    font-size: 12px;
                    color: Palette.on-variant;
                    vertical-alignment: center;
                }
                ComboBox {
                    model: root.profiles;
                    current-index <=> root.profile;
                }
                Text {
                    text: Tr.editor-modtype;
                    font-size: 12px;
                    color: Palette.on-variant;
                    vertical-alignment: center;
                }
                ComboBox {
                    model: root.modtypes;
                    current-index <=> root.modtype;
                }
            }

            HorizontalLayout {
                spacing: 16px;
                CheckBox {
                    text: Tr.editor-needs-greg;
                    checked <=> root.needs-greg;
                    toggled => { root.changed(); }
                }
                CheckBox {
                    text: Tr.editor-needs-ml;
                    checked <=> root.needs-ml;
                    toggled => { root.changed(); }
                }
            }

            SectionTitle { text: Tr.editor-section-deps; }
            for dep[idx] in root.deps: HorizontalLayout {
                spacing: 8px;
                Text {
                    text: dep;
                    font-size: 12px;
                    color: Palette.on-surface;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                GregButton {
                    text: Tr.editor-remove;
                    has-icon: true;
                    icon: IconSet.Trash2;
                    variant: "danger";
                    clicked => { root.dep-remove(idx); }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                LineEdit {
                    text <=> root.dep-add-text;
                    placeholder-text: Tr.editor-workshop-id-placeholder;
                    horizontal-stretch: 1;
                }
                GregButton {
                    text: Tr.editor-add-by-id;
                    has-icon: true;
                    icon: IconSet.ListPlus;
                    clicked => { root.dep-add(); }
                }
            }

            SectionTitle { text: Tr.editor-section-assets; }
            ListCard {
                height: 120px;
                Image {
                    source: root.preview-image;
                    width: 100%;
                    height: 100%;
                    image-fit: contain;
                }
            }
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: Tr.editor-preview;
                    font-size: 12px;
                    color: Palette.on-variant;
                    vertical-alignment: center;
                }
                Text {
                    text: root.preview-text;
                    font-size: 11px;
                    color: Palette.on-surface;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                    overflow: elide;
                }
                GregButton {
                    text: Tr.editor-pick-preview;
                    has-icon: true;
                    icon: IconSet.ImagePlus;
                    clicked => { root.pick-preview(); }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: Tr.editor-screenshots;
                    font-size: 12px;
                    color: Palette.on-variant;
                    vertical-alignment: center;
                }
                GregButton {
                    text: Tr.editor-add-screenshot;
                    has-icon: true;
                    icon: IconSet.ImagePlus;
                    clicked => { root.add-shot(); }
                }
            }
            for shot[idx] in root.shots: HorizontalLayout {
                spacing: 8px;
                Text {
                    text: shot;
                    font-size: 11px;
                    color: Palette.on-variant;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                    overflow: elide;
                }
                GregButton {
                    text: Tr.editor-remove;
                    has-icon: true;
                    icon: IconSet.Trash2;
                    variant: "danger";
                    clicked => { root.remove-shot(idx); }
                }
            }

            SectionTitle { text: Tr.editor-section-changelog; }
            TextEdit {
                text <=> root.changelog;
                height: 90px;
                edited(_) => { root.changed(); }
            }
            Text {
                text: root.changelog-hint;
                font-size: 11px;
                color: Palette.on-variant;
                wrap: word-wrap;
            }

            SectionTitle { text: Tr.editor-section-checks; }
            Text {
                text: root.readiness-text;
                font-size: 12px;
                font-weight: 700;
                color: root.ready ? Palette.secondary : Palette.error;
            }
            for check in root.checks: VerticalLayout {
                spacing: 0px;
                HorizontalLayout {
                    spacing: 6px;
                    AppIcon {
                        icon: check.ok ? IconSet.CircleCheck : IconSet.CircleX;
                        size: 14px;
                        stroke: check.ok ? Palette.secondary : Palette.error;
                    }
                    Text {
                        text: check.label;
                        font-size: 12px;
                        font-weight: 700;
                        color: check.ok ? Palette.secondary : Palette.error;
                    }
                }
                Text {
                    text: check.detail;
                    font-size: 11px;
                    color: Palette.on-variant;
                    wrap: word-wrap;
                }
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                GregButton {
                    text: Tr.editor-save;
                    has-icon: true;
                    icon: IconSet.Save;
                    clicked => { root.save(); }
                }
                GregButton {
                    text: Tr.editor-save-and-upload;
                    has-icon: true;
                    icon: IconSet.CloudUpload;
                    variant: "primary";
                    enabled: !root.publishing;
                    clicked => { root.publish(); }
                }
                GregButton {
                    text: Tr.editor-modstore-upload;
                    has-icon: true;
                    icon: IconSet.ShoppingBag;
                    enabled: !root.publishing;
                    clicked => { root.publish-modstore(); }
                }
                if root.publishing: GregButton {
                    text: Tr.editor-cancel;
                    has-icon: true;
                    icon: IconSet.Ban;
                    clicked => { root.cancel-publish(); }
                }
            }

            if root.publishing || root.status != "": VerticalLayout {
                spacing: 4px;
                if root.publishing: ProgressIndicator {
                    progress: root.progress;
                }
                Text {
                    text: root.status;
                    font-size: 11px;
                    color: Palette.on-variant;
                }
                ListCard {
                    height: 110px;
                    Flickable {
                        VerticalLayout {
                            padding: 6px;
                            for line in root.log: Text {
                                text: line;
                                font-size: 10px;
                                font-family: "monospace";
                                color: Palette.on-variant;
                            }
                        }
                    }
                }
            }
        }
    }
}
