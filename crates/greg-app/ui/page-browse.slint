import { LineEdit, ComboBox } from "std-widgets.slint";
import { ScrollView } from "std-widgets.slint";
import { IconSet } from "@lucide";
import { Palette, SectionTitle, Thumb, GregButton, ListCard } from "theme.slint";
import { AppIcon } from "icons.slint";
import { BrowseRow } from "models.slint";
import { Tr } from "i18n.slint";

export component BrowsePage inherits VerticalLayout {
    in-out property <int> list;
    in-out property <[string]> lists;
    in-out property <int> sort;
    in-out property <[string]> sorts;
    in-out property <string> search;
    in-out property <string> tag;
    in-out property <int> page;
    in-out property <int> total;
    in-out property <[BrowseRow]> items;
    in-out property <string> selected;
    in-out property <bool> has-detail;
    in-out property <string> d-title;
    in-out property <string> d-author;
    in-out property <string> d-status-state;
    in-out property <image> d-preview;
    in-out property <string> d-meta;
    in-out property <string> d-tags;
    in-out property <string> d-desc;
    in-out property <string> d-deps;
    in-out property <bool> d-subscribed;
    in-out property <string> status;
    in-out property <bool> busy;

    callback refresh();
    callback search-go();
    callback filter-changed();
    callback cancel();
    callback select(string);
    callback prev-page();
    callback next-page();
    callback subscribe-toggle();
    callback import-item();
    callback view-on-steam();

    spacing: 8px;
    padding: 18px;

    SectionTitle { text: Tr.browse-title; }

    Rectangle {
        height: 36px;
        HorizontalLayout {
            width: parent.width;
            height: parent.height;
            spacing: 8px;
            alignment: center;
            ComboBox {
                width: 170px;
                model: root.lists;
                current-index <=> root.list;
                selected(_) => { root.filter-changed(); }
            }
            ComboBox {
                width: 150px;
                model: root.sorts;
                current-index <=> root.sort;
                selected(_) => { root.filter-changed(); }
            }
            Rectangle { horizontal-stretch: 1; }
        }
    }
    Rectangle {
        height: 36px;
        HorizontalLayout {
            width: parent.width;
            height: parent.height;
            spacing: 8px;
            alignment: center;
            LineEdit {
                text <=> root.search;
                placeholder-text: Tr.browse-search-placeholder;
                horizontal-stretch: 1;
                accepted => { root.search-go(); }
            }
            Text {
                text: Tr.browse-tag;
                font-size: 12px;
                color: Palette.on-variant;
                vertical-alignment: center;
            }
            LineEdit {
                text <=> root.tag;
                placeholder-text: Tr.browse-tag-placeholder;
                width: 140px;
            }
            GregButton {
                text: Tr.browse-search;
                has-icon: true;
                icon: IconSet.Search;
                enabled: !root.busy;
                clicked => { root.search-go(); }
            }
            if root.busy: GregButton {
                text: Tr.browse-cancel;
                has-icon: true;
                icon: IconSet.Ban;
                clicked => { root.cancel(); }
            }
        }
    }
    Text {
        text: root.status;
        font-size: 11px;
        color: Palette.on-variant;
    }

    HorizontalLayout {
        spacing: 8px;
        vertical-stretch: 1;
        min-height: 120px;

        ListCard {
            horizontal-stretch: 1;
            ScrollView {
                width: parent.width;
                height: parent.height;
                VerticalLayout {
                    padding: 6px;
                    spacing: 2px;
                    for item in root.items: Rectangle {
                        height: 40px;
                        background: item.id == root.selected ? Palette.container-high : transparent;
                        border-radius: Palette.radius-lg;
                        touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.select(item.id); }
                        }
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 8px;
                            alignment: center;
                            Thumb {
                                src: item.thumb;
                                px: 30px;
                            }
                            Text {
                                text: item.title;
                                font-size: 12px;
                                color: Palette.on-surface;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            AppIcon {
                                icon: IconSet.Star;
                                size: 13px;
                                stroke: Palette.on-variant;
                            }
                            Text {
                                text: item.score;
                                font-size: 11px;
                                color: Palette.on-variant;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        ListCard {
            horizontal-stretch: 1;
            ScrollView {
                width: parent.width;
                height: parent.height;
                VerticalLayout {
                    padding: 10px;
                    spacing: 6px;
                    if !root.has-detail: Text {
                        text: Tr.browse-select-hint;
                        font-size: 12px;
                        color: Palette.on-variant;
                    }
                    if root.has-detail && root.d-preview.width > 0: Rectangle {
                        height: 140px;
                        background: Palette.container-low;
                        border-radius: Palette.radius;
                        border-width: 1px;
                        border-color: Palette.outline;
                        Image {
                            source: root.d-preview;
                            width: 100%;
                            height: 100%;
                            image-fit: contain;
                        }
                    }
                    if root.has-detail: Text {
                        text: root.d-title;
                        font-size: 15px;
                        font-weight: 700;
                        color: Palette.on-surface;
                        wrap: word-wrap;
                    }
                    if root.has-detail && root.d-author != "": HorizontalLayout {
                        spacing: 6px;
                        Text {
                            text: Tr.browse-author-label;
                            font-size: 11px;
                            font-weight: 700;
                            color: Palette.on-variant;
                        }
                        Text {
                            text: root.d-author;
                            font-size: 11px;
                            color: Palette.on-surface;
                            overflow: elide;
                        }
                    }
                    if root.has-detail && root.d-status-state != "": HorizontalLayout {
                        spacing: 6px;
                        Text {
                            text: Tr.browse-status-label;
                            font-size: 11px;
                            font-weight: 700;
                            color: Palette.on-variant;
                        }
                        Text {
                            text: root.d-status-state;
                            font-size: 11px;
                            font-weight: 700;
                            color: Palette.secondary;
                            overflow: elide;
                        }
                    }
                    if root.has-detail: Text {
                        text: root.d-meta;
                        font-size: 11px;
                        color: Palette.on-variant;
                        wrap: word-wrap;
                    }
                    if root.has-detail && root.d-tags != "": Text {
                        text: root.d-tags;
                        font-size: 11px;
                        color: Palette.on-variant;
                        wrap: word-wrap;
                    }
                    if root.has-detail: Text {
                        text: root.d-desc;
                        font-size: 12px;
                        color: Palette.on-surface;
                        wrap: word-wrap;
                    }
                    if root.has-detail && root.d-deps != "": Text {
                        text: root.d-deps;
                        font-size: 11px;
                        color: Palette.primary;
                        wrap: word-wrap;
                    }
                    if root.has-detail: Rectangle {
                        height: 36px;
                        HorizontalLayout {
                            width: parent.width;
                            height: parent.height;
                            spacing: 8px;
                            alignment: center;
                            GregButton {
                                text: root.d-subscribed ? Tr.browse-unsubscribe : Tr.browse-subscribe;
                                has-icon: true;
                                icon: root.d-subscribed ? IconSet.BellOff : IconSet.Bell;
                                clicked => { root.subscribe-toggle(); }
                            }
                            GregButton {
                                text: Tr.browse-import;
                                has-icon: true;
                                icon: IconSet.Download;
                                clicked => { root.import-item(); }
                            }
                            GregButton {
                                text: Tr.browse-steam-page;
                                has-icon: true;
                                icon: IconSet.ExternalLink;
                                clicked => { root.view-on-steam(); }
                            }
                        }
                    }
                }
            }
        }
    }

    Rectangle {
        height: 36px;
        HorizontalLayout {
            width: parent.width;
            height: parent.height;
            spacing: 8px;
            alignment: center;
            GregButton {
                text: Tr.browse-prev;
                has-icon: true;
                icon: IconSet.ChevronLeft;
                clicked => { root.prev-page(); }
            }
            Text {
                text: Tr.browse-page-word + " " + root.page + " (" + root.total + " " + Tr.browse-total-word + ")";
                font-size: 11px;
                color: Palette.on-variant;
                vertical-alignment: center;
            }
            GregButton {
                text: Tr.browse-next;
                has-icon: true;
                icon: IconSet.ChevronRight;
                clicked => { root.next-page(); }
            }
        }
    }
}
