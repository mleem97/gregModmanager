import { LineEdit, ComboBox } from "std-widgets.slint";
import { ScrollView, HorizontalBox } from "std-widgets.slint";
import { IconSet } from "@lucide";
import { Palette, SectionTitle, Thumb, GregButton, ListCard } from "theme.slint";
import { ProjectRow } from "models.slint";
import { Tr } from "i18n.slint";

export component ProjectsPage inherits VerticalLayout {
    in-out property <string> search;
    in-out property <[ProjectRow]> rows;

    callback refresh();
    callback open-project(string);
    callback open-folder();
    callback request-new-project();
    callback view-on-steam(string);

    spacing: 12px;
    padding: 18px;

    SectionTitle { text: Tr.projects-title; }

    // Such- und Aktionsleiste oben
    Rectangle {
        height: 36px;
        HorizontalLayout {
            width: parent.width;
            height: parent.height;
            spacing: 8px;
            alignment: start;
            GregButton {
                text: Tr.projects-new-project;
                has-icon: true;
                icon: IconSet.Plus;
                variant: "primary";
                clicked => { root.request-new-project(); }
            }
            LineEdit {
                text <=> root.search;
                placeholder-text: Tr.projects-search-placeholder;
                horizontal-stretch: 1;
            }
        }
        HorizontalLayout {
            width: parent.width;
            height: parent.height;
            spacing: 8px;
            alignment: end;
            
            
            GregButton {
                text: Tr.projects-refresh;
                has-icon: true;
                icon: IconSet.RefreshCw;
                clicked => { root.refresh(); }
            }
            GregButton {
                text: Tr.projects-open-folder;
                has-icon: true;
                icon: IconSet.FolderOpen;
                clicked => { root.open-folder(); }
            }
        }
    }

    // Hauptbereich: Projektliste über die volle Breite
    ListCard {
        vertical-stretch: 1;
        min-height: 200px;
        ScrollView {
            width: parent.width;
            height: parent.height;
            VerticalLayout {
                padding: 8px;
                spacing: 6px;
                for row[idx] in root.rows: Rectangle {
                    height: 56px;
                    background: Palette.container;
                    border-radius: Palette.radius-lg;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 10px;
                        alignment: center;
                        
                        Thumb {
                            src: row.thumb;
                            px: 40px;
                        }

                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 2px;
                            Text {
                                text: row.title;
                                font-size: 13px;
                                font-weight: 700;
                                color: Palette.on-surface;
                                overflow: elide;
                            }
                            Text {
                                text: row.meta;
                                font-size: 11px;
                                color: Palette.on-variant;
                                overflow: elide;
                            }
                        }

                        if row.fileid != "": GregButton {
                            text: Tr.projects-steam;
                            has-icon: true;
                            icon: IconSet.ExternalLink;
                            clicked => { root.view-on-steam(row.fileid); }
                        }

                        GregButton {
                            text: Tr.projects-edit;
                            has-icon: true;
                            icon: IconSet.PenLine;
                            variant: "primary";
                            clicked => { root.open-project(row.root); }
                        }
                    }
                }
            }
        }
    }
}