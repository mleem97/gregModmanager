import { IconSet } from "@lucide";
import { Button, VerticalBox, HorizontalBox, LineEdit, ComboBox, StandardButton, ScrollView } from "std-widgets.slint";
import {
    Palette,
    IconButton,
    NavButton,
    StatusLed,
    WinBtn,
    TopBarButton,
    TopIconButton,
    GregButton,
    ListCard,
} from "theme.slint";
import { AppIcon } from "icons.slint";
import {
    NavItem,
    ProjectRow,
    CheckRow,
    BrowseRow,
    StoreRow,
    UpdateRow,
    HealthRow,
    LocalRow,
    ProblemRow,
    PackRow,
    PackEntryRow,
    LibInstallRow,
} from "models.slint";
import { LocalPage } from "page-local.slint";
import { PacksPage } from "page-packs.slint";
import { ProblemsPage } from "page-problems.slint";
import { ProjectsPage } from "page-projects.slint";
import { EditorPage } from "page-editor.slint";
import { BrowsePage } from "page-browse.slint";
import { StorePage } from "page-store.slint";
import { SettingsPage } from "page-settings.slint";
import { ReportPage } from "page-report.slint";
import { Tr } from "i18n.slint";

export { Tr }

export component MainWindow inherits Window {
    title: "gregModmanager";
    no-frame: true;
    min-width: 800px;
    min-height: 600px;
    preferred-width: 1000px;
    preferred-height: 700px;
    background: Palette.container-low;
    icon: @image-url("../../../G.svg");
    resize-border-width: 6px;

    // --- shell state (Rust <-> Slint) ---
    in-out property <string> app-version: "";
    in-out property <string> current-icon: "modmanager";
    in-out property <string> current-page: "mymods";
    in-out property <bool> ed-needsgreg: true;
    in-out property <bool> nav-visible: true;
    in-out property <string> nav-title: "MODMANAGER";
    in-out property <[NavItem]> nav-items;
    in-out property <bool> steam-ok: false;
    in-out property <string> steam-text: "Steam Disconnected";
    in-out property <bool> gregapi-ok: false;
    in-out property <string> gregapi-text: "gregAPI Disconnected";
    in-out property <bool> melonloader-ok: false;
    in-out property <string> melonloader-text: "MelonLoader: checking…";
    in-out property <bool> modstore-available: true;
    in-out property <bool> login-visible: false;
    in-out property <bool> show-new-modal: false;
    in-out property <bool> game-running: false;
    in-out property <string> game-text: "Game: stopped";
    in-out property <bool> profile-visible: false;
    in-out property <string> profile-name: "";
    in-out property <string> profile-hint: "";

    // --- projects page state ---
    in-out property <string> project-search;
    in-out property <[ProjectRow]> projects;
    in-out property <string> new-folder;
    in-out property <int> new-template;
    in-out property <[string]> new-templates;
    in-out property <int> project-filter-index: 0;
    in-out property <[string]> project-filters: ["All", "Published", "Updated", "Unreleased"];

    // --- editor page state ---
    in-out property <string> ed-title;
    in-out property <string> ed-version;
    in-out property <string> ed-desc;
    in-out property <string> ed-tags;
    in-out property <int> ed-visibility;
    in-out property <[string]> ed-visibilities;
    in-out property <int> ed-profile;
    in-out property <[string]> ed-profiles;
    in-out property <int> ed-modtype;
    in-out property <[string]> ed-modtypes;
    in-out property <bool> ed-needsml;
    in-out property <string> ed-changelog;
    in-out property <string> ed-changelog-hint;
    in-out property <string> ed-desc-hint;
    in-out property <string> ed-fileid-text;
    in-out property <string> ed-project-name;
    in-out property <[CheckRow]> ed-checks;
    in-out property <bool> ed-ready;
    in-out property <string> ed-readiness-text;
    in-out property <[string]> ed-deps;
    in-out property <string> ed-dep-add-text;
    in-out property <string> ed-preview-text;
    in-out property <image> ed-preview-image;
    in-out property <[string]> ed-shots;
    in-out property <float> ed-progress;
    in-out property <bool> ed-publishing;
    in-out property <string> ed-status;
    in-out property <[string]> ed-log;

    // --- browse page state ---
    in-out property <int> br-list;
    in-out property <[string]> br-lists;
    in-out property <int> br-sort;
    in-out property <[string]> br-sorts;
    in-out property <string> br-search;
    in-out property <string> br-tag;
    in-out property <int> br-page;
    in-out property <int> br-total;
    in-out property <[BrowseRow]> br-items;
    in-out property <string> br-selected;
    in-out property <bool> br-has-detail;
    in-out property <string> br-d-title;
    in-out property <string> br-d-author;
    in-out property <string> br-d-status-state;
    in-out property <image> br-d-preview;
    in-out property <string> br-d-meta;
    in-out property <string> br-d-tags;
    in-out property <string> br-d-desc;
    in-out property <string> br-d-deps;
    in-out property <bool> br-d-subscribed;
    in-out property <string> br-status;
    in-out property <bool> br-busy;

    // --- modstore page state ---
    in-out property <string> st-search;
    in-out property <[StoreRow]> st-items;
    in-out property <[UpdateRow]> st-updates;
    in-out property <float> st-progress;
    in-out property <bool> st-busy;
    in-out property <string> st-status;

    // --- local content page state ---
    in-out property <string> local-title;
    in-out property <string> local-search;
    in-out property <[LocalRow]> local-active-rows;
    in-out property <[LocalRow]> local-inactive-rows;
    in-out property <string> local-status;
    in-out property <bool> show-lib-modal: false;
    in-out property <[LibInstallRow]> lib-catalog;
    in-out property <bool> lib-busy: false;
    in-out property <string> lib-status;
    in-out property <bool> show-plugin-modal: false;
    in-out property <[LibInstallRow]> plugin-catalog;
    in-out property <bool> plugin-busy: false;
    in-out property <string> plugin-status;

    // --- problems page state ---
    in-out property <[ProblemRow]> problem-rows;
    in-out property <string> problem-status;

    // --- report assistant page state ---
    in-out property <string> rp-title;
    in-out property <int> rp-category-index: 0;
    in-out property <[string]> rp-categories;
    in-out property <string> rp-description;
    in-out property <string> rp-steps;
    in-out property <string> rp-expected;
    in-out property <string> rp-actual;
    in-out property <string> rp-logs;
    in-out property <string> rp-environment;
    in-out property <string> rp-preview;
    in-out property <string> rp-status;
    in-out property <string> rp-submission;
    in-out property <[string]> rp-attachments;
    in-out property <bool> rp-submit-confirm: false;
    in-out property <string> rp-submit-mode;

    // --- packs page state ---
    in-out property <string> pack-kind;
    in-out property <string> pack-title;
    in-out property <[PackRow]> pack-packs;
    in-out property <int> pack-selected: -1;
    in-out property <[PackEntryRow]> pack-entries;
    in-out property <string> pack-new-name;
    in-out property <string> pack-status;

    // --- dialogs & settings ---
    in-out property <bool> show-confirm: false;
    in-out property <string> confirm-text;
    in-out property <bool> show-bug-dialog: false;
    in-out property <bool> show-profile-menu: false;
    in-out property <string> se-workspace;
    in-out property <string> se-gameroot;
    in-out property <int> se-lang;
    in-out property <[string]> se-langs;
    in-out property <string> se-modstore-url;
    in-out property <string> se-steam-web-api-key;
    in-out property <string> se-telemetry-text;
    in-out property <[HealthRow]> se-health;
    in-out property <[string]> se-log;

    // --- callbacks ---
    callback icon-clicked(string);
    callback nav-clicked(string);
    callback start-game(string);
    callback stop-game();
    callback login-clicked();
    callback profile-clicked();
    callback profile-menu-clicked(string);
    callback window-minimize();
    callback window-maximize();
    callback window-close();

    callback local-refresh();
    callback local-toggle(int);
    callback local-remove(int);
    callback local-open-folder();
    callback lib-open-modal();
    callback lib-toggle-select(int);
    callback lib-select-missing();
    callback lib-select-all();
    callback lib-install-selected();
    callback lib-close-modal();
    callback plugin-open-modal();
    callback plugin-toggle-select(int);
    callback plugin-select-missing();
    callback plugin-select-all();
    callback plugin-install-selected();
    callback plugin-install-default();
    callback plugin-close-modal();
    callback confirm-yes();
    callback confirm-no();
    callback bug-open-manager();
    callback bug-open-org();
    callback bug-close();

    callback problems-refresh();
    callback problems-act(int);

    callback rp-generate();
    callback rp-cancel();
    callback rp-submit();
    callback rp-export();
    callback rp-attach();
    callback rp-collect-logs();
    callback rp-confirm-yes();
    callback rp-confirm-no();

    callback packs-create();
    callback packs-select(int);
    callback packs-toggle(int);
    callback packs-delete(int);
    callback packs-toggle-entry(int);
    callback packs-remove-entry(int);
    callback packs-add-file();
    callback packs-export(int);
    callback packs-import();
    callback packs-apply(int);

    callback project-refresh();
    callback project-open(string);
    callback project-open-folder();
    callback project-create();
    callback project-view-steam(string);
    callback project-filter-changed(int);

    callback ed-changed();
    callback ed-save();
    callback ed-publish();
    callback ed-publish-modstore();
    callback ed-cancel-publish();
    callback ed-pick-preview();
    callback ed-add-shot();
    callback ed-remove-shot(int);
    callback ed-dep-add();
    callback ed-dep-remove(int);
    callback ed-view-steam();

    callback br-go();
    callback br-filter-changed();
    callback br-cancel();
    callback br-select(string);
    callback br-prev();
    callback br-next();
    callback br-subscribe-toggle();
    callback br-import();
    callback br-view-steam();

    callback st-refresh();
    callback st-check-updates();
    callback st-cancel();
    callback st-install(int);
    callback st-install-update(int);

    callback se-apply-lang();
    callback se-apply-workspace();
    callback se-browse-workspace();
    callback se-apply-gameroot();
    callback se-browse-gameroot();
    callback se-apply-modstore-url();
    callback se-apply-steam-web-api-key();
    callback se-run-checks();
    callback se-open-logs();
    callback se-make-bundle();
    callback se-register-protocol();

    Rectangle {
        background: Palette.surface;
        border-radius: 10px;

        HorizontalLayout {
            spacing: 0px;

            // Far-left icon bar, full height.
            Rectangle {
                width: 64px;
                background: Palette.avatar-bg;
                border-bottom-right-radius: 20px;
                border-top-right-radius: 20px;

                VerticalLayout {
                    padding-bottom: 8px;
                    spacing: 4px;

                    // Logo container (fixed 64x64, no overflowing min-size blocks)
                    Rectangle {
                        width: 64px;
                        height: 64px;
                        Image {
                            source: @image-url("../../../G.svg");
                            width: 32px;
                            height: 30px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            image-fit: contain;
                        }

                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.icon-clicked("modmanager");
                            }
                        }
                    }

                    VerticalLayout {
                        cross-axis-alignment: center;
                        IconButton {
                            icon: IconSet.LayoutGrid;
                            tip: Tr.tip-modmanager;
                            active: root.current-icon == "modmanager";
                            clicked => {
                                root.icon-clicked("modmanager");
                            }
                        }

                        IconButton {
                            icon: IconSet.Upload;
                            tip: Tr.tip-workshop;
                            active: root.current-icon == "workshop";
                            clicked => {
                                root.icon-clicked("workshop");
                            }
                        }

                        IconButton {
                            icon: IconSet.ShoppingBag;
                            tip: Tr.tip-modstore;
                            active: root.current-icon == "modstore";
                            enabled: root.modstore-available;
                            clicked => {
                                root.icon-clicked("modstore");
                            }
                        }

                        IconButton {
                            icon: IconSet.Settings;
                            tip: Tr.tip-settings;
                            active: root.current-icon == "settings";
                            clicked => {
                                root.icon-clicked("settings");
                            }
                        }

                        IconButton {
                            icon: IconSet.Bug;
                            tip: Tr.tip-report-bug;
                            clicked => {
                                root.bug-open-manager();
                            }
                        }

                        IconButton {
                            icon: root.profile-visible ? IconSet.LogOut : IconSet.LogIn;
                            tip: root.profile-visible ? Tr.tip-logout : Tr.tip-login;
                            danger: root.profile-visible;
                            clicked => {
                                if (root.profile-visible) {
                                    root.profile-menu-clicked("logout");
                                } else {
                                    root.login-clicked();
                                }
                            }
                        }
                    }

                    VerticalLayout {
                        horizontal-stretch: 0;
                        vertical-stretch: 0;
                        alignment: start;
                        spacing: 4px;
                    }
                }
            }

            // Right column: header, main row, status bar.
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 0px;

                // Header with window-move area.
                Rectangle {
                    height: 42px;
                    background: Palette.container-low;
                    WindowMoveArea {
                        width: parent.width;
                        height: parent.height;
                    }

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 6px;
                        spacing: 8px;

                        Rectangle {
                            horizontal-stretch: 1;
                        }

                        HorizontalLayout {
                            padding-top: 6px;
                            padding-bottom: 6px;
                            spacing: 8px;
                            alignment: center;

                            if !root.game-running: TopIconButton {
                                icon: IconSet.Play;
                                tip: Tr.tip-start-game-vanilla;
                                text: Tr.btn-start-game;
                                clicked => {
                                    root.start-game("vanilla");
                                }
                            }

                            if !root.game-running: TopIconButton {
                                icon: IconSet.PlayCircle;
                                tip: Tr.tip-start-game-mods;
                                text: Tr.btn-start-game-mods;
                                clicked => {
                                    root.start-game("mods");
                                }
                            }

                            if root.game-running: TopIconButton {
                                icon: IconSet.Square;
                                tip: Tr.tip-stop-game;
                                text: Tr.btn-stop-game;
                                clicked => {
                                    root.stop-game();
                                }
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                        }

                        if root.login-visible: TopBarButton {
                            text: Tr.btn-login;
                            btn-width: 72px;
                            clicked => {
                                root.login-clicked();
                            }
                        }

                        if root.profile-visible: Rectangle {
                            height: 34px;
                            preferred-width: 180px;
                            min-width: 0px;
                            background: Palette.container;
                            border-radius: Palette.radius;
                            border-width: 1px;
                            border-color: Palette.outline;
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.profile-clicked();
                                }
                            }

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 10px;
                                spacing: 8px;
                                Rectangle {
                                    width: 24px;
                                    height: 24px;
                                    y: (parent.height - self.height) / 2;
                                    background: Palette.avatar-bg;
                                    border-radius: 12px;
                                    AppIcon {
                                        icon: IconSet.UserRound;
                                        size: 14px;
                                        stroke: Palette.primary;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    Text {
                                        text: root.profile-name;
                                        font-size: 12px;
                                        font-weight: 700;
                                        color: Palette.on-surface;
                                        overflow: elide;
                                    }

                                    Text {
                                        text: root.profile-hint;
                                        font-size: 10px;
                                        color: Palette.on-variant;
                                        overflow: elide;
                                    }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 0px;
                            WinBtn {
                                icon: IconSet.Minus;
                                clicked => {
                                    root.window-minimize();
                                }
                            }

                            WinBtn {
                                icon: root.maximized ? IconSet.Copy : IconSet.Square;
                                clicked => {
                                    root.window-maximize();
                                }
                            }

                            WinBtn {
                                icon: IconSet.X;
                                danger: true;
                                clicked => {
                                    root.window-close();
                                }
                            }
                        }
                    }
                }

                // Main row: responsive navigation + content pages.
                HorizontalLayout {
                    spacing: 0px;
                    vertical-stretch: 1;

                    // Conditional responsive navigation.
                    if root.nav-visible: Rectangle {
                        min-width: 140px;
                        preferred-width: 175px;
                        max-width: 200px;
                        horizontal-stretch: 0;
                        background: Palette.container-low;

                        VerticalLayout {
                            padding: 14px;
                            alignment: start;

                            HorizontalLayout {
                                spacing: 6px;
                                alignment: start;
                                Rectangle {
                                    width: 24px;
                                    height: 24px;
                                    background: Palette.avatar-bg;
                                    border-radius: 12px;
                                    AppIcon {
                                        icon: IconSet.LayoutGrid;
                                        size: 14px;
                                        stroke: Palette.primary;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                    }
                                }

                                Text {
                                    text: root.nav-title;
                                    font-size: 11px;
                                    font-weight: 700;
                                    letter-spacing: 2px;
                                    color: Palette.primary;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }

                            for item in root.nav-items: NavButton {
                                label: item.label;
                                active: root.current-page == item.id;
                                clicked => {
                                    root.nav-clicked(item.id);
                                }
                            }
                        }
                    }

                    // Content pages container.
                    Rectangle {
                        horizontal-stretch: 1;
                        background: Palette.surface;

                        VerticalLayout {
                            vertical-stretch: 1;

                            if root.current-page == "mymods" || root.current-page == "myplugins" || root.current-page == "mylibs": LocalPage {
                                vertical-stretch: 1;
                                is-libs: root.current-page == "mylibs";
                                is-plugins: root.current-page == "myplugins";
                                title <=> root.local-title;
                                search <=> root.local-search;
                                active-rows <=> root.local-active-rows;
                                inactive-rows <=> root.local-inactive-rows;
                                status <=> root.local-status;
                                refresh => { root.local-refresh(); }
                                toggle(idx) => { root.local-toggle(idx); }
                                remove(idx) => { root.local-remove(idx); }
                                open-folder => { root.local-open-folder(); }
                                open-lib-modal => { root.lib-open-modal(); }
                                open-plugin-modal => { root.plugin-open-modal(); }
                                install-plugins => { root.plugin-install-default(); }
                            }
                            if root.current-page == "problems": ProblemsPage {
                                vertical-stretch: 1;
                                rows <=> root.problem-rows;
                                status <=> root.problem-status;
                                refresh => { root.problems-refresh(); }
                                act(idx) => { root.problems-act(idx); }
                            }
                            if root.current-page == "modpacks" || root.current-page == "collections": PacksPage {
                                vertical-stretch: 1;
                                kind <=> root.pack-kind;
                                title <=> root.pack-title;
                                packs <=> root.pack-packs;
                                selected <=> root.pack-selected;
                                entries <=> root.pack-entries;
                                new-name <=> root.pack-new-name;
                                status <=> root.pack-status;
                                create => { root.packs-create(); }
                                select(idx) => { root.packs-select(idx); }
                                toggle-pack(idx) => { root.packs-toggle(idx); }
                                delete-pack(idx) => { root.packs-delete(idx); }
                                toggle-entry(idx) => { root.packs-toggle-entry(idx); }
                                remove-entry(idx) => { root.packs-remove-entry(idx); }
                                add-local-file => { root.packs-add-file(); }
                                export-pack(idx) => { root.packs-export(idx); }
                                import-pack => { root.packs-import(); }
                                apply-pack(idx) => { root.packs-apply(idx); }
                            }
                            if root.current-page == "projects" || root.current-page == "new": ProjectsPage {
                                vertical-stretch: 1;
                                search <=> root.project-search;
                                rows <=> root.projects;
                                refresh => { root.project-refresh(); }
                                open-project(path) => { root.project-open(path); }
                                open-folder => { root.project-open-folder(); }
                                request-new-project => { root.show-new-modal = true; }
                                view-on-steam(id) => { root.project-view-steam(id); }
                            }
                            if root.current-page == "editor": EditorPage {
                                vertical-stretch: 1;
                                title <=> root.ed-title;
                                version <=> root.ed-version;
                                desc <=> root.ed-desc;
                                tags <=> root.ed-tags;
                                visibility <=> root.ed-visibility;
                                visibilities <=> root.ed-visibilities;
                                profile <=> root.ed-profile;
                                profiles <=> root.ed-profiles;
                                modtype <=> root.ed-modtype;
                                modtypes <=> root.ed-modtypes;
                                needs-greg <=> root.ed-needsgreg;
                                needs-ml <=> root.ed-needsml;
                                changelog <=> root.ed-changelog;
                                changelog-hint <=> root.ed-changelog-hint;
                                desc-hint <=> root.ed-desc-hint;
                                fileid-text <=> root.ed-fileid-text;
                                project-name <=> root.ed-project-name;
                                checks <=> root.ed-checks;
                                ready <=> root.ed-ready;
                                readiness-text <=> root.ed-readiness-text;
                                deps <=> root.ed-deps;
                                dep-add-text <=> root.ed-dep-add-text;
                                preview-text <=> root.ed-preview-text;
                                preview-image <=> root.ed-preview-image;
                                shots <=> root.ed-shots;
                                progress <=> root.ed-progress;
                                publishing <=> root.ed-publishing;
                                status <=> root.ed-status;
                                log <=> root.ed-log;
                                changed => { root.ed-changed(); }
                                save => { root.ed-save(); }
                                publish => { root.ed-publish(); }
                                cancel-publish => { root.ed-cancel-publish(); }
                                pick-preview => { root.ed-pick-preview(); }
                                add-shot => { root.ed-add-shot(); }
                                remove-shot(idx) => { root.ed-remove-shot(idx); }
                                dep-add => { root.ed-dep-add(); }
                                dep-remove(idx) => { root.ed-dep-remove(idx); }
                                view-on-steam => { root.ed-view-steam(); }
                            }
                            if root.current-page == "browse": BrowsePage {
                                vertical-stretch: 1;
                                list <=> root.br-list;
                                lists <=> root.br-lists;
                                sort <=> root.br-sort;
                                sorts <=> root.br-sorts;
                                search <=> root.br-search;
                                tag <=> root.br-tag;
                                page <=> root.br-page;
                                total <=> root.br-total;
                                items <=> root.br-items;
                                selected <=> root.br-selected;
                                has-detail <=> root.br-has-detail;
                                d-title <=> root.br-d-title;
                                d-author <=> root.br-d-author;
                                d-status-state <=> root.br-d-status-state;
                                d-preview <=> root.br-d-preview;
                                d-meta <=> root.br-d-meta;
                                d-tags <=> root.br-d-tags;
                                d-desc <=> root.br-d-desc;
                                d-deps <=> root.br-d-deps;
                                d-subscribed <=> root.br-d-subscribed;
                                status <=> root.br-status;
                                busy <=> root.br-busy;
                                refresh => { root.br-go(); }
                                search-go => { root.br-go(); }
                                filter-changed => { root.br-filter-changed(); }
                                cancel => { root.br-cancel(); }
                                select(id) => { root.br-select(id); }
                                prev-page => { root.br-prev(); }
                                next-page => { root.br-next(); }
                                subscribe-toggle => { root.br-subscribe-toggle(); }
                                import-item => { root.br-import(); }
                                view-on-steam => { root.br-view-steam(); }
                            }
                            if root.current-page == "modstore": StorePage {
                                vertical-stretch: 1;
                                search <=> root.st-search;
                                items <=> root.st-items;
                                updates <=> root.st-updates;
                                progress <=> root.st-progress;
                                busy <=> root.st-busy;
                                status <=> root.st-status;
                                refresh => { root.st-refresh(); }
                                check-updates => { root.st-check-updates(); }
                                cancel => { root.st-cancel(); }
                                install(idx) => { root.st-install(idx); }
                                install-update(idx) => { root.st-install-update(idx); }
                            }
                            if root.current-page == "settings": SettingsPage {
                                vertical-stretch: 1;
                                workspace <=> root.se-workspace;
                                gameroot <=> root.se-gameroot;
                                lang <=> root.se-lang;
                                langs <=> root.se-langs;
                                modstore-url <=> root.se-modstore-url;
                                steam-web-api-key <=> root.se-steam-web-api-key;
                                telemetry-text <=> root.se-telemetry-text;
                                health <=> root.se-health;
                                log <=> root.se-log;
                                apply-lang => { root.se-apply-lang(); }
                                apply-workspace => { root.se-apply-workspace(); }
                                browse-workspace => { root.se-browse-workspace(); }
                                apply-gameroot => { root.se-apply-gameroot(); }
                                browse-gameroot => { root.se-browse-gameroot(); }
                                apply-modstore-url => { root.se-apply-modstore-url(); }
                                apply-steam-web-api-key => { root.se-apply-steam-web-api-key(); }
                                run-checks => { root.se-run-checks(); }
                                open-logs => { root.se-open-logs(); }
                                make-bundle => { root.se-make-bundle(); }
                                register-protocol => { root.se-register-protocol(); }
                            }
                            if root.current-page == "report": ReportPage {
                                vertical-stretch: 1;
                                title <=> root.rp-title;
                                category-index <=> root.rp-category-index;
                                categories <=> root.rp-categories;
                                description <=> root.rp-description;
                                steps <=> root.rp-steps;
                                expected <=> root.rp-expected;
                                actual <=> root.rp-actual;
                                logs <=> root.rp-logs;
                                environment <=> root.rp-environment;
                                preview <=> root.rp-preview;
                                status <=> root.rp-status;
                                submission <=> root.rp-submission;
                                attachments <=> root.rp-attachments;
                                show-submit-confirm <=> root.rp-submit-confirm;
                                submit-mode <=> root.rp-submit-mode;
                                generate => { root.rp-generate(); }
                                collect-logs => { root.rp-collect-logs(); }
                                cancel => { root.rp-cancel(); }
                                submit => { root.rp-submit(); }
                                export => { root.rp-export(); }
                                attach => { root.rp-attach(); }
                                confirm-yes => { root.rp-confirm-yes(); }
                                confirm-no => { root.rp-confirm-no(); }
                            }
                        }
                    }
                }

                // Bottom status bar.
                Rectangle {
                    height: 30px;
                    background: Palette.container-low;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 18px;
                        alignment: end;

                        StatusLed {
                            ok: root.steam-ok;
                            text: root.steam-text;
                        }

                        StatusLed {
                            ok: root.gregapi-ok;
                            text: root.gregapi-text;
                        }

                        StatusLed {
                            ok: root.melonloader-ok;
                            text: root.melonloader-text;
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                        }

                        Text {
                            text: "v" + root.app-version;
                            font-size: 11px;
                            color: Palette.on-variant;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // --- Modals & Overlays ---

        if root.show-new-modal: Rectangle {
            width: parent.width;
            height: parent.height;
            background: #00000099;

            TouchArea {
                clicked => {
                    root.show-new-modal = false;
                }
            }

            Rectangle {
                width: 420px;
                height: 260px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                background: Palette.container;
                border-radius: Palette.radius-lg;
                border-width: 1px;
                border-color: Palette.primary;

                TouchArea {}

                VerticalLayout {
                    padding: 20px;
                    spacing: 14px;

                    Text {
                        text: Tr.new-modal-title;
                        font-size: 14px;
                        font-weight: 700;
                        color: Palette.on-surface;
                    }

                    VerticalLayout {
                        spacing: 4px;
                        Text {
                            text: Tr.new-modal-folder-name;
                            font-size: 11px;
                            color: Palette.on-variant;
                        }

                        LineEdit {
                            text <=> root.new-folder;
                            placeholder-text: Tr.new-modal-folder-placeholder;
                        }
                    }

                    VerticalLayout {
                        spacing: 4px;
                        Text {
                            text: Tr.new-modal-template;
                            font-size: 11px;
                            color: Palette.on-variant;
                        }

                        ComboBox {
                            model: root.new-templates;
                            current-index <=> root.new-template;
                        }
                    }

                    Rectangle {
                        vertical-stretch: 1;
                    }

                    HorizontalLayout {
                        spacing: 10px;
                        alignment: end;
                        GregButton {
                            text: Tr.modal-cancel;
                            has-icon: true;
                            icon: IconSet.Ban;
                            clicked => {
                                root.show-new-modal = false;
                            }
                        }

                        GregButton {
                            text: Tr.new-modal-create-open;
                            has-icon: true;
                            icon: IconSet.Plus;
                            variant: "primary";
                            clicked => {
                                root.project-create();
                                root.show-new-modal = false;
                            }
                        }
                    }
                }
            }
        }

        if root.show-confirm: Rectangle {
            width: parent.width;
            height: parent.height;
            background: #00000099;
            TouchArea {}

            Rectangle {
                width: 380px;
                height: 150px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                background: Palette.container;
                border-radius: Palette.radius;
                border-width: 1px;
                border-color: Palette.primary;

                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;
                    alignment: center;
                    Text {
                        text: root.confirm-text;
                        font-size: 13px;
                        color: Palette.on-surface;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                    }

                    HorizontalLayout {
                        spacing: 10px;
                        alignment: center;
                        GregButton {
                            text: Tr.confirm-delete;
                            has-icon: true;
                            icon: IconSet.Trash2;
                            variant: "danger";
                            clicked => {
                                root.confirm-yes();
                            }
                        }

                        GregButton {
                            text: Tr.confirm-cancel;
                            has-icon: true;
                            icon: IconSet.Ban;
                            clicked => {
                                root.confirm-no();
                            }
                        }
                    }
                }
            }
        }

        if root.show-bug-dialog: Rectangle {
            width: parent.width;
            height: parent.height;
            background: #00000099;
            TouchArea {}

            Rectangle {
                width: 420px;
                height: 230px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                background: Palette.container;
                border-radius: Palette.radius;
                border-width: 1px;
                border-color: Palette.primary;

                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;
                    alignment: center;
                    Text {
                        text: Tr.bug-dialog-title;
                        font-size: 14px;
                        font-weight: 700;
                        color: Palette.on-surface;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: Tr.bug-dialog-subtitle;
                        font-size: 11px;
                        color: Palette.on-variant;
                        horizontal-alignment: center;
                    }

                    GregButton {
                        text: Tr.bug-dialog-this-app;
                        has-icon: true;
                        icon: IconSet.LayoutGrid;
                        clicked => {
                            root.bug-open-manager();
                        }
                    }

                    GregButton {
                        text: Tr.bug-dialog-other-mods;
                        has-icon: true;
                        icon: IconSet.Package;
                        clicked => {
                            root.bug-open-org();
                        }
                    }

                    GregButton {
                        text: Tr.modal-cancel;
                        has-icon: true;
                        icon: IconSet.Ban;
                        clicked => {
                            root.bug-close();
                        }
                    }
                }
            }
        }

        if root.show-profile-menu && root.profile-visible: Rectangle {
            width: parent.width;
            height: parent.height;
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.profile-clicked();
                }
            }

            Rectangle {
                width: 220px;
                height: 164px;
                x: parent.width - self.width - 70px;
                y: 44px;
                background: Palette.container;
                border-radius: Palette.radius;
                border-width: 1px;
                border-color: Palette.outline;

                VerticalLayout {
                    padding: 8px;
                    spacing: 4px;
                    alignment: start;
                    GregButton {
                        text: Tr.btn-my-mods;
                        has-icon: true;
                        icon: IconSet.Package;
                        clicked => {
                            root.profile-menu-clicked("mymods");
                        }
                    }

                    GregButton {
                        text: Tr.btn-upload;
                        has-icon: true;
                        icon: IconSet.Upload;
                        clicked => {
                            root.profile-menu-clicked("upload");
                        }
                    }

                    GregButton {
                        text: Tr.btn-settings;
                        has-icon: true;
                        icon: IconSet.Settings;
                        clicked => {
                            root.profile-menu-clicked("settings");
                        }
                    }

                    GregButton {
                        text: Tr.btn-logout;
                        has-icon: true;
                        icon: IconSet.LogOut;
                        clicked => {
                            root.profile-menu-clicked("logout");
                        }
                    }
                }
            }
        }

        if root.show-lib-modal: Rectangle {
            width: parent.width;
            height: parent.height;
            background: #00000099;

            TouchArea {
                clicked => {
                    if (!root.lib-busy) {
                        root.lib-close-modal();
                    }
                }
            }

            Rectangle {
                width: min(580px, parent.width - 40px);
                height: min(490px, parent.height - 40px);
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                background: Palette.container;
                border-radius: Palette.radius-lg;
                border-width: 1px;
                border-color: Palette.primary;

                TouchArea {}

                VerticalLayout {
                    padding: 20px;
                    spacing: 10px;

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: space-between;
                        VerticalLayout {
                            spacing: 2px;
                            Text {
                                text: Tr.lib-modal-title;
                                font-size: 14px;
                                font-weight: 700;
                                color: Palette.on-surface;
                            }
                            Text {
                                text: Tr.lib-modal-subtitle;
                                font-size: 11px;
                                color: Palette.on-variant;
                            }
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: end;
                            GregButton {
                                text: Tr.modal-select-missing;
                                enabled: !root.lib-busy;
                                clicked => { root.lib-select-missing(); }
                            }
                            GregButton {
                                text: Tr.modal-select-all;
                                enabled: !root.lib-busy;
                                clicked => { root.lib-select-all(); }
                            }
                        }
                    }

                    ListCard {
                        vertical-stretch: 1;
                        min-height: 200px;
                        ScrollView {
                            width: parent.width;
                            height: parent.height;
                            VerticalLayout {
                                padding: 6px;
                                spacing: 4px;
                                for row in root.lib-catalog: Rectangle {
                                    height: 40px;
                                    background: row.selected ? Palette.avatar-bg : Palette.container;
                                    border-radius: Palette.radius;
                                    border-width: 1px;
                                    border-color: row.selected ? Palette.primary : Palette.outline;

                                    TouchArea {
                                        mouse-cursor: root.lib-busy ? default : pointer;
                                        clicked => {
                                            if (!root.lib-busy) {
                                                root.lib-toggle-select(row.index);
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        spacing: 10px;

                                        Rectangle {
                                            width: 18px;
                                            height: 18px;
                                            y: (parent.height - self.height) / 2;
                                            border-radius: 4px;
                                            border-width: 1px;
                                            border-color: row.selected ? Palette.primary : Palette.outline;
                                            background: row.selected ? Palette.primary : Palette.container-low;
                                            if row.selected: AppIcon {
                                                icon: IconSet.Check;
                                                size: 12px;
                                                stroke: Palette.on-primary;
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                            }
                                        }

                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            min-width: 0px;
                                            alignment: center;
                                            Text {
                                                text: row.name;
                                                font-size: 12px;
                                                font-weight: 700;
                                                color: Palette.on-surface;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: row.detail;
                                                font-size: 10px;
                                                color: Palette.on-variant;
                                                overflow: elide;
                                            }
                                        }

                                        Rectangle {
                                            width: 78px;
                                            height: 22px;
                                            y: (parent.height - self.height) / 2;
                                            border-radius: 11px;
                                            background: Palette.container-low;
                                            border-width: 1px;
                                            border-color: row.installed ? Palette.secondary : Palette.outline;
                                            Text {
                                                text: row.installed ? Tr.modal-installed : Tr.modal-missing;
                                                font-size: 10px;
                                                font-weight: 700;
                                                color: row.installed ? Palette.secondary : Palette.on-variant;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    Text {
                        text: root.lib-status;
                        font-size: 11px;
                        color: Palette.on-variant;
                        overflow: elide;
                    }

                    HorizontalLayout {
                        spacing: 10px;
                        alignment: end;
                        GregButton {
                            text: Tr.modal-cancel;
                            has-icon: true;
                            icon: IconSet.Ban;
                            enabled: !root.lib-busy;
                            clicked => {
                                root.lib-close-modal();
                            }
                        }
                        GregButton {
                            text: root.lib-busy ? Tr.modal-installing : Tr.modal-install-selected;
                            has-icon: true;
                            icon: IconSet.Plus;
                            variant: "primary";
                            enabled: !root.lib-busy;
                            clicked => {
                                root.lib-install-selected();
                            }
                        }
                    }
                }
            }
        }

        if root.show-plugin-modal: Rectangle {
            width: parent.width;
            height: parent.height;
            background: #00000099;

            TouchArea {
                clicked => {
                    if (!root.plugin-busy) {
                        root.plugin-close-modal();
                    }
                }
            }

            Rectangle {
                width: min(580px, parent.width - 40px);
                height: min(460px, parent.height - 40px);
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                background: Palette.container;
                border-radius: Palette.radius-lg;
                border-width: 1px;
                border-color: Palette.primary;

                TouchArea {}

                VerticalLayout {
                    padding: 20px;
                    spacing: 10px;

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: space-between;
                        VerticalLayout {
                            spacing: 2px;
                            Text {
                                text: Tr.plugin-modal-title;
                                font-size: 14px;
                                font-weight: 700;
                                color: Palette.on-surface;
                            }
                            Text {
                                text: Tr.plugin-modal-subtitle;
                                font-size: 11px;
                                color: Palette.on-variant;
                            }
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: end;
                            GregButton {
                                text: Tr.modal-select-missing;
                                enabled: !root.plugin-busy;
                                clicked => { root.plugin-select-missing(); }
                            }
                            GregButton {
                                text: Tr.modal-select-all;
                                enabled: !root.plugin-busy;
                                clicked => { root.plugin-select-all(); }
                            }
                        }
                    }

                    ListCard {
                        vertical-stretch: 1;
                        min-height: 180px;
                        ScrollView {
                            width: parent.width;
                            height: parent.height;
                            VerticalLayout {
                                padding: 6px;
                                spacing: 4px;
                                for row in root.plugin-catalog: Rectangle {
                                    height: 44px;
                                    background: row.selected ? Palette.avatar-bg : Palette.container;
                                    border-radius: Palette.radius;
                                    border-width: 1px;
                                    border-color: row.selected ? Palette.primary : Palette.outline;

                                    TouchArea {
                                        mouse-cursor: root.plugin-busy ? default : pointer;
                                        clicked => {
                                            if (!root.plugin-busy) {
                                                root.plugin-toggle-select(row.index);
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        spacing: 10px;

                                        Rectangle {
                                            width: 18px;
                                            height: 18px;
                                            y: (parent.height - self.height) / 2;
                                            border-radius: 4px;
                                            border-width: 1px;
                                            border-color: row.selected ? Palette.primary : Palette.outline;
                                            background: row.selected ? Palette.primary : Palette.container-low;
                                            if row.selected: AppIcon {
                                                icon: IconSet.Check;
                                                size: 12px;
                                                stroke: Palette.on-primary;
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                            }
                                        }

                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            min-width: 0px;
                                            alignment: center;
                                            Text {
                                                text: row.name;
                                                font-size: 12px;
                                                font-weight: 700;
                                                color: Palette.on-surface;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: row.detail;
                                                font-size: 10px;
                                                color: Palette.on-variant;
                                                overflow: elide;
                                            }
                                        }

                                        Rectangle {
                                            width: 78px;
                                            height: 22px;
                                            y: (parent.height - self.height) / 2;
                                            border-radius: 11px;
                                            background: Palette.container-low;
                                            border-width: 1px;
                                            border-color: row.installed ? Palette.secondary : Palette.outline;
                                            Text {
                                                text: row.installed ? Tr.modal-installed : Tr.modal-missing;
                                                font-size: 10px;
                                                font-weight: 700;
                                                color: row.installed ? Palette.secondary : Palette.on-variant;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    Text {
                        text: root.plugin-status;
                        font-size: 11px;
                        color: Palette.on-variant;
                        overflow: elide;
                    }

                    HorizontalLayout {
                        spacing: 10px;
                        alignment: end;
                        GregButton {
                            text: Tr.modal-cancel;
                            has-icon: true;
                            icon: IconSet.Ban;
                            enabled: !root.plugin-busy;
                            clicked => {
                                root.plugin-close-modal();
                            }
                        }
                        GregButton {
                            text: root.plugin-busy ? Tr.modal-installing : Tr.modal-install-selected;
                            has-icon: true;
                            icon: IconSet.Plus;
                            variant: "primary";
                            enabled: !root.plugin-busy;
                            clicked => {
                                root.plugin-install-selected();
                            }
                        }
                    }
                }
            }
        }
    }
}