import { ScrollView } from "std-widgets.slint";
import { IconSet } from "@lucide";
import { Palette, SectionTitle, GregButton, ListCard } from "theme.slint";
import { AppIcon } from "icons.slint";
import { ProblemRow } from "models.slint";

// Problems inbox: aggregated diagnostics (game root, Steam, GregApi,
// health checks, unpublished project changes). Each row can jump to the
// responsible page via its action.
export component ProblemsPage inherits VerticalLayout {
    in-out property <[ProblemRow]> rows;
    in-out property <string> status;

    callback refresh();
    callback act(int);

    spacing: 8px;
    padding: 18px;

    SectionTitle { text: "PROBLEMS"; }

    HorizontalLayout {
        spacing: 8px;
        GregButton {
            text: "Re-check";
            has-icon: true;
            icon: IconSet.RefreshCw;
            clicked => { root.refresh(); }
        }
    }
    Text {
        text: root.status;
        font-size: 11px;
        color: Palette.on-variant;
    }

    ListCard {
        vertical-stretch: 1;
        min-height: 96px;
        ScrollView {
            width: parent.width;
            height: parent.height;
            VerticalLayout {
                padding: 6px;
                spacing: 4px;
                for row in root.rows: Rectangle {
                    background: Palette.container;
                    border-radius: Palette.radius-lg;
                    HorizontalLayout {
                        padding: 8px;
                        spacing: 10px;
                        AppIcon {
                            icon: row.severity == "error" ? IconSet.CircleX : (row.severity == "warning" ? IconSet.TriangleAlert : IconSet.Info);
                            size: 18px;
                            stroke: row.severity == "error" ? Palette.error : (row.severity == "warning" ? #E8B93E : Palette.primary);
                            y: (parent.height - self.height) / 2;
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            Text {
                                text: row.source;
                                font-size: 11px;
                                font-weight: 700;
                                letter-spacing: 1px;
                                color: Palette.on-variant;
                            }
                            Text {
                                text: row.message;
                                font-size: 12px;
                                color: Palette.on-surface;
                                wrap: word-wrap;
                            }
                        }
                        if row.has-action: GregButton {
                            text: row.action-label;
                            has-icon: true;
                            icon: IconSet.ArrowRight;
                            clicked => { root.act(row.index); }
                        }
                    }
                }
            }
        }
    }
}
