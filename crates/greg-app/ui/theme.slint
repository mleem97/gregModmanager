// TerminalCore theme (ported from the frozen C# Avalonia Styles): fixed geometry,
// no auto-sizing surprises. All colors are constants — never magic values.
//
// Icons: unicode glyphs / emoji are banned. Every icon is a Lucide `Icon`
// rendered through `IconDisplay` (see `icons.slint` / `@lucide`).

import { IconDisplay, Icon } from "@lucide";

export global Palette {
    out property <color> surface: #051424;
    out property <color> container-low: #0D1C2D;
    out property <color> container: #122131;
    out property <color> container-high: #1C2B3C;
    out property <color> primary: #8AEBFF;
    out property <color> primary-dim: #8AEBFF1F;
    out property <color> on-primary: #062235;
    out property <color> secondary: #4DE082;
    out property <color> on-surface: #D4E4FA;
    out property <color> on-variant: #BBC9CD;
    out property <color> outline: #3C494C;
    out property <color> error: #FFB4AB;
    out property <color> error-container: #3C1B22;
    out property <color> led-ok: #4DE082;
    out property <color> led-bad: #D7383B;
    out property <color> avatar-bg: #17364A;
    // Soft neumorphism helpers (subtle on purpose): light edge on top,
    // faint dark lift below. Keep alpha low — flat first, depth second.
    out property <color> top-highlight: #FFFFFF0D;
    out property <color> soft-shadow: #00000045;
    out property <length> radius: 6px;
    out property <length> radius-lg: 10px;
}

// Fixed 56x56 icon button with a 3px active indicator on the left edge.
export component IconButton inherits Rectangle {
    in property <Icon> icon;
    in property <string> tip;
    in property <bool> active;
    // Red tint for destructive actions (e.g. logout).
    in property <bool> danger: false;
    in property <bool> enabled <=> touch.enabled;
    callback clicked();

    width: 56px;
    height: 56px;
    background: active ? Palette.container-high : transparent;
    border-radius: Palette.radius;

    touch := TouchArea {
        enabled: true;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    // Active indicator: fixed 3x28 bar, vertically centered.
    if active: Rectangle {
        x: 4px;
        y: (parent.height - self.height) / 2;
        width: 3px;
        height: 28px;
        background: Palette.primary;
        border-radius: 2px;
    }

    IconDisplay {
        icon: root.icon;
        size: 22px;
        stroke: !root.enabled ? Palette.outline : (root.danger ? Palette.error : (root.active ? Palette.primary : Palette.on-variant));
        stroke-width: 1.8;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    @children
}

// Unified button used by every page: fixed 32px height, label plus an
// optional Lucide icon, three variants (`ghost` | `primary` | `danger`).
// Custom rectangles cannot measure text, so callers size the width via
// layout (stretch) or `min-width` — never zero-width.
export component GregButton inherits Rectangle {
    in property <string> text;
    in property <Icon> icon;
    in property <bool> has-icon: false;
    // "ghost" | "primary" | "danger"
    in property <string> variant: "ghost";
    in property <bool> enabled <=> touch.enabled;
    callback clicked();

    min-width: 84px;
    height: 32px;
    border-radius: Palette.radius-lg;



    property <bool> is-primary: root.variant == "primary";
    property <bool> is-danger: root.variant == "danger";
    property <color> base: root.is-primary ? Palette.primary : (root.is-danger ? Palette.error-container : transparent);
    property <color> hover-base: root.is-primary ? Palette.primary : (root.is-danger ? #5A2530 : Palette.container-high);

    background: touch.pressed ? (root.is-primary ? Palette.primary : Palette.avatar-bg) : (touch.has-hover ? root.hover-base : root.base);
    border-color: root.is-danger ? Palette.error : (touch.has-hover || root.is-primary ? Palette.outline : transparent);
    // Subtle lift — flat first, depth second.
    drop-shadow-blur: touch.has-hover ? 8px : 4px;
    drop-shadow-color: Palette.soft-shadow;
    drop-shadow-offset-y: 1px;
    opacity: root.enabled ? 1.0 : 0.45;

    touch := TouchArea {
        enabled: true;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        alignment: center;
        spacing: 6px;
        padding-left: 10px;
        padding-right: 10px;
        if root.has-icon: VerticalLayout {
            alignment: center;
            IconDisplay {
                icon: root.icon;
                size: 15px;
                stroke: root.is-primary ? Palette.on-primary : (root.is-danger ? Palette.error : Palette.on-surface);
                stroke-width: 2.0;
            }
        }
        Text {
            text: root.text;
            font-size: 12px;
            font-weight: root.is-primary ? 700 : 400;
            horizontal-alignment: TextHorizontalAlignment.center;
            color: root.is-primary ? Palette.on-primary : (root.is-danger ? Palette.error : Palette.on-surface);
            vertical-alignment: TextVerticalAlignment.center;
        }
    }
}

// Unified scroll-list container: soft card with a faint top highlight.
// Callers put a `ScrollView` inside; the box keeps a fixed frame
// (`vertical-stretch` + `min-height`) so long lists scroll internally.
export component ListCard inherits Rectangle {
    background: Palette.container-low;
    border-radius: Palette.radius-lg;
    border-width: 1px;
    border-color: Palette.outline;
    clip: true;

    // Faint top edge — the subtle neumorphic light.
    Rectangle {
        width: parent.width;
        height: 1px;
        background: Palette.top-highlight;
    }

    @children
}

// Full-width navigation row, fixed 36px height, active = primary fill.
export component NavButton inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked();

    height: 36px;
    background: active ? Palette.primary : transparent;
    border-radius: Palette.radius;

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    Text {
        x: 12px;
        text: root.label;
        font-size: 13px;
        font-weight: active ? 700 : 400;
        color: active ? Palette.on-primary : Palette.on-surface;
        vertical-alignment: center;
    }
}

// Flat topbar button: transparent at rest, slightly lighter on hover,
// primary-tinted while pressed. Fixed width (labels are known) — custom
// rectangles cannot measure text, so no auto-sizing here.
export component TopBarButton inherits Rectangle {
    in property <string> text;
    in property <length> btn-width: 96px;
    callback clicked();

    width: root.btn-width;
    height: 30px;
    background: touch.has-hover ? (touch.pressed ? Palette.avatar-bg : Palette.container-high) : transparent;
    border-radius: Palette.radius-lg;
    border-width: 1px;
    border-color: touch.has-hover ? Palette.outline : transparent;

    touch := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    Text {
        text: root.text;
        font-size: 12px;
        color: Palette.on-surface;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Fixed 34x28 titlebar window button (custom chrome, no native frame).
export component WinBtn inherits Rectangle {
    in property <Icon> icon;
    in property <bool> danger;
    callback clicked();

    width: 34px;
    height: 28px;
    // Slint has no :hover selector — TouchArea state drives the fill.
    background: touch.has-hover ? (root.danger ? #7A1F1F : Palette.container) : transparent;

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    IconDisplay {
        icon: root.icon;
        size: 14px;
        stroke: touch.has-hover && root.danger ? #FFFFFF : Palette.on-variant;
        stroke-width: 2.0;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
}

// 8px status LED + label, fixed height.
export component StatusLed inherits HorizontalLayout {
    in property <bool> ok;
    in property <string> text;

    spacing: 8px;
    alignment: start;

    Rectangle {
        width: 8px;
        height: 8px;
        y: (parent.height - self.height) / 2;
        border-radius: 4px;
        background: root.ok ? Palette.led-ok : Palette.led-bad;
    }
    Text {
        text: root.text;
        font-size: 11px;
        color: Palette.on-variant;
        vertical-alignment: center;
    }
}

// Section headline with accent bar.
export component SectionTitle inherits HorizontalLayout {
    in property <string> text;

    spacing: 10px;

    Rectangle {
        width: 22px;
        height: 2px;
        y: (parent.height - self.height) / 2;
        background: Palette.primary;
    }
    Text {
        text: root.text;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 2px;
        color: Palette.primary;
        vertical-alignment: center;
    }
}

// Form row: fixed 130px label + stretching field.
export component FieldRow inherits HorizontalLayout {
    in property <string> label;

    spacing: 8px;

    Text {
        width: 130px;
        text: root.label;
        font-size: 12px;
        color: Palette.on-variant;
        vertical-alignment: center;
    }

    @children
}

// Dark card container.
export component Card inherits Rectangle {
    background: Palette.container;
    border-radius: Palette.radius-lg;
    border-width: 1px;
    border-color: Palette.outline;

    @children
}

// List thumbnail: fixed box with a subtle placeholder behind the image.
// An empty image renders nothing, so rows without artwork show the box.
export component Thumb inherits Rectangle {
    in-out property <image> src;
    in-out property <length> px: 40px;

    width: root.px;
    height: root.px;
    background: Palette.container-high;
    border-radius: 4px;
    clip: true;
    Image {
        source: root.src;
        width: 100%;
        height: 100%;
        image-fit: cover;
    }
}
