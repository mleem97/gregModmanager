import { LineEdit, ComboBox } from "std-widgets.slint";
import { IconSet } from "@lucide";
import { Palette, SectionTitle, FieldRow, GregButton, ListCard } from "theme.slint";
import { AppIcon } from "icons.slint";
import { HealthRow } from "models.slint";

export component SettingsPage inherits VerticalLayout {
    in-out property <string> workspace;
    in-out property <string> gameroot;
    in-out property <int> lang;
    in-out property <[string]> langs;
    in-out property <string> modstore-url;
    in-out property <string> telemetry-text;
    in-out property <[HealthRow]> health;
    in-out property <[string]> log;

    callback apply-workspace();
    callback browse-workspace();
    callback apply-gameroot();
    callback browse-gameroot();
    callback apply-modstore-url();
    callback run-checks();
    callback open-logs();
    callback make-bundle();
    callback register-protocol();

    spacing: 8px;
    padding: 18px;

    Flickable {
        vertical-stretch: 1;
        VerticalLayout {
            spacing: 8px;

            SectionTitle { text: "GENERAL"; }

            FieldRow {
                label: "Language";
                ComboBox {
                    model: root.langs;
                    current-index <=> root.lang;
                    horizontal-stretch: 1;
                }
            }
            FieldRow {
                label: "Workspace";
                HorizontalLayout {
                    spacing: 6px;
                    horizontal-stretch: 1;
                    LineEdit {
                        text <=> root.workspace;
                        horizontal-stretch: 1;
                    }
                    GregButton {
                        text: "Browse";
                        has-icon: true;
                        icon: IconSet.FolderOpen;
                        clicked => { root.browse-workspace(); }
                    }
                    GregButton {
                        text: "Apply";
                        has-icon: true;
                        icon: IconSet.Check;
                        variant: "primary";
                        clicked => { root.apply-workspace(); }
                    }
                }
            }
            FieldRow {
                label: "Game root";
                HorizontalLayout {
                    spacing: 6px;
                    horizontal-stretch: 1;
                    LineEdit {
                        text <=> root.gameroot;
                        horizontal-stretch: 1;
                    }
                    GregButton {
                        text: "Browse";
                        has-icon: true;
                        icon: IconSet.FolderOpen;
                        clicked => { root.browse-gameroot(); }
                    }
                    GregButton {
                        text: "Apply";
                        has-icon: true;
                        icon: IconSet.Check;
                        variant: "primary";
                        clicked => { root.apply-gameroot(); }
                    }
                }
            }
            FieldRow {
                label: "Modstore API";
                HorizontalLayout {
                    spacing: 6px;
                    horizontal-stretch: 1;
                    LineEdit {
                        text <=> root.modstore-url;
                        horizontal-stretch: 1;
                    }
                    GregButton {
                        text: "Apply";
                        has-icon: true;
                        icon: IconSet.Check;
                        variant: "primary";
                        clicked => { root.apply-modstore-url(); }
                    }
                }
            }
            Text {
                text: root.telemetry-text;
                font-size: 11px;
                color: Palette.on-variant;
            }

            SectionTitle { text: "DIAGNOSTICS"; }
            GregButton {
                text: "Run checks";
                has-icon: true;
                icon: IconSet.Stethoscope;
                clicked => { root.run-checks(); }
            }
            for check in root.health: HorizontalLayout {
                spacing: 8px;
                AppIcon {
                    icon: check.ok ? IconSet.CircleCheck : IconSet.CircleX;
                    size: 16px;
                    stroke: check.ok ? Palette.secondary : Palette.error;
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    Text {
                        text: check.label;
                        font-size: 12px;
                        font-weight: 700;
                        color: Palette.on-surface;
                    }
                    Text {
                        text: check.detail;
                        font-size: 11px;
                        color: Palette.on-variant;
                        wrap: word-wrap;
                    }
                }
            }

            SectionTitle { text: "SUPPORT"; }
            Rectangle {
                height: 36px;
                HorizontalLayout {
                    width: parent.width;
                    height: parent.height;
                    spacing: 8px;
                    alignment: center;
                    GregButton {
                        text: "Open log folder";
                        has-icon: true;
                        icon: IconSet.FolderOpen;
                        clicked => { root.open-logs(); }
                    }
                    GregButton {
                        text: "Support bundle";
                        has-icon: true;
                        icon: IconSet.Package;
                        clicked => { root.make-bundle(); }
                    }
                    GregButton {
                        text: "Register greg://";
                        has-icon: true;
                        icon: IconSet.Plug;
                        clicked => { root.register-protocol(); }
                    }
                }
            }
            Rectangle {
                height: 120px;
                background: Palette.container-low;
                border-radius: Palette.radius;
                border-width: 1px;
                border-color: Palette.outline;
                Flickable {
                    VerticalLayout {
                        padding: 6px;
                        for line in root.log: Text {
                            text: line;
                            font-size: 10px;
                            font-family: "monospace";
                            color: Palette.on-variant;
                        }
                    }
                }
            }
        }
    }
}
