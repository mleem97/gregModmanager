+using System.Text.Json;
+using HarmonyLib;
+
+namespace gregCore.GameLayer.Patches.ModLoader;
+
+/// <summary>Managed workspace contract v1. Readiness is emitted only after
+/// actual patch and early source-registration verification, never by descriptor.</summary>
+public static class ManagedWorkspaceGuard
+{
+    public static void Initialize()
+    {
+        if (Environment.GetEnvironmentVariable("GREGMODMANAGER_MANAGED") != "1") return;
+        try
+        {
+            var session = Required("GREGMODMANAGER_SESSION");
+            var ready = Path.GetFullPath(Required("GREGMODMANAGER_READY"));
+            var root = Path.GetFullPath(Required("GREGMODMANAGER_ROOT"));
+            if (!session.All(c => ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9')) || c == '-'))
+                throw new InvalidOperationException("Invalid manager session.");
+            RejectLinkedAncestors(root);
+            RejectLinkedAncestors(ready);
+            var expected = Path.Combine(root, "Configs", "runtime", session + ".ready.json");
+            if (!string.Equals(ready, expected, StringComparison.Ordinal))
+                throw new InvalidOperationException("Readiness path does not belong to manager session.");
+            using var sources = JsonDocument.Parse(File.ReadAllText(ready + ".sources.json"));
+            var record = sources.RootElement;
+            if (record.GetProperty("schemaVersion").GetInt32() != 1
+                || record.GetProperty("session").GetString() != session
+                || !record.GetProperty("managedSources").GetBoolean())
+                throw new InvalidOperationException("Early Companion source registration was not acknowledged.");
+            var harmony = new HarmonyLib.Harmony("gregCore.managed-workspace.v1");
+            VanillaModloaderSilencer.NeutralizeRequired(harmony);
+            // Atomic publication: no reader may observe a partial acknowledgement.
+            var tmp = ready + ".tmp";
+            File.WriteAllText(tmp, JsonSerializer.Serialize(new { schemaVersion = 1, session,
+                vanillaBlocked = true, managedSources = true }));
+            File.Move(tmp, ready, true);
+        }
+        catch (Exception error)
+        {
+            // MelonLoader catches initialization exceptions and could otherwise
+            // continue with vanilla copying. A managed launch must stop instead.
+            Environment.FailFast("Managed workspace guard failed before game initialization.", error);
+        }
+    }
+
+
+    private static readonly HashSet<IntPtr> LoadedNativeInstances = new();
+
+    public static bool BlockLoadAllMods(global::Il2Cpp.ModLoader __instance)
+    {
+        LoadNativeMods(__instance);
+        return false;
+    }
+
+    public static void LoadNativeMods(global::Il2Cpp.ModLoader instance)
+    {
+        try
+        {
+            if (instance == null || instance.Pointer == IntPtr.Zero)
+                throw new InvalidOperationException("Native loader instance is unavailable.");
+            if (!LoadedNativeInstances.Add(instance.Pointer)) return;
+            var root = Path.Combine(Path.GetFullPath(Required("GREGMODMANAGER_ROOT")), "GameModding", "Mods");
+            RejectLinkedAncestors(root);
+            if (!Directory.Exists(root)) return;
+            var pending = new Stack<string>();
+            pending.Push(root);
+            while (pending.Count != 0)
+            {
+                var path = pending.Pop();
+                var info = new DirectoryInfo(path);
+                if ((info.Attributes & FileAttributes.ReparsePoint) != 0)
+                    throw new InvalidOperationException("Linked native package: " + path);
+                foreach (var file in info.EnumerateFiles())
+                    if ((file.Attributes & FileAttributes.ReparsePoint) != 0)
+                        throw new InvalidOperationException("Linked native asset: " + file.FullName);
+                var config = Path.Combine(path, "config.json");
+                if (File.Exists(config))
+                {
+                    using var document = JsonDocument.Parse(File.ReadAllText(config));
+                    ValidateAssetReferences(document.RootElement, path);
+                    // Original read-only asset reader. LoadDll remains blocked.
+                    instance.LoadModPack(path);
+                    continue;
+                }
+                foreach (var directory in info.EnumerateDirectories().OrderBy(d => d.Name, StringComparer.Ordinal))
+                    if (!directory.Name.StartsWith('.') && !directory.Name.EndsWith(".disabled", StringComparison.OrdinalIgnoreCase))
+                        pending.Push(directory.FullName);
+            }
+        }
+        catch (Exception error) { Environment.FailFast("Managed native asset loading failed.", error); }
+    }
+
+    private static void ValidateAssetReferences(JsonElement value, string package)
+    {
+        if (value.ValueKind == JsonValueKind.Array)
+        {
+            foreach (var item in value.EnumerateArray()) ValidateAssetReferences(item, package);
+        }
+        else if (value.ValueKind == JsonValueKind.Object)
+        {
+            foreach (var property in value.EnumerateObject())
+            {
+                if (property.NameEquals("dlls") && property.Value.ValueKind == JsonValueKind.Array && property.Value.GetArrayLength() != 0)
+                    throw new InvalidOperationException("Native DLL entries are not allowed in managed asset packages; use Melon mods.");
+                if (property.Name is "modelFile" or "textureFile" or "iconFile")
+                {
+                    var relative = property.Value.GetString() ?? "";
+                    if (relative.Length == 0) continue;
+                    if (Path.IsPathRooted(relative) || relative.Contains(':')
+                        || relative.Split(new[] { '/', '\\' }).Any(segment => segment == ".."))
+                        throw new InvalidOperationException("Native asset escapes package: " + relative);
+                    var resolved = Path.GetFullPath(Path.Combine(package, relative));
+                    foreach (var part in relative.Split(new[] { '/', '\\' }, StringSplitOptions.RemoveEmptyEntries))
+                        if (part == ".") throw new InvalidOperationException("Ambiguous native asset path.");
+                    // Reject linked parents as well as linked asset files.
+                    for (var candidate = resolved; candidate != package; candidate = Path.GetDirectoryName(candidate)!)
+                    {
+                        if (string.IsNullOrEmpty(candidate)) throw new InvalidOperationException("Native asset path escaped package.");
+                        if ((File.GetAttributes(candidate) & FileAttributes.ReparsePoint) != 0)
+                            throw new InvalidOperationException("Native asset path contains a link.");
+                    }
+                }
+                else ValidateAssetReferences(property.Value, package);
+            }
+        }
+    }
+
+
+    private static void RejectLinkedAncestors(string path)
+    {
+        for (string? current = Path.GetFullPath(path); current != null; current = Path.GetDirectoryName(current))
+        {
+            try
+            {
+                if ((File.GetAttributes(current) & FileAttributes.ReparsePoint) != 0)
+                    throw new InvalidOperationException("Managed path contains a linked ancestor: " + current);
+            }
+            catch (FileNotFoundException) { }
+            catch (DirectoryNotFoundException) { }
+        }
+    }
+
+    private static string Required(string name) => Environment.GetEnvironmentVariable(name)
+        is { Length: > 0 } value ? value : throw new InvalidOperationException(name + " is required.");
+}
