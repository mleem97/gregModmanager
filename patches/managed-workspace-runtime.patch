+using System.Text.Json;
+using GregCompanion.Configuration;
+
+namespace GregCompanion;
+
+/// <summary>Pre-folder-scan managed contract; normal-plugin fallback is too late.</summary>
+public static class ManagedWorkspaceContract
+{
+    public static bool Enabled => Environment.GetEnvironmentVariable("GREGMODMANAGER_MANAGED") == "1";
+
+    public static void ApplyPolicy(SteamModfixConfiguration config)
+    {
+        if (!Enabled) return;
+        config.Enabled = true;
+        config.Sources.SteamWorkshop = false;
+        config.Sources.StreamingAssets = false;
+        config.Staging.EnableDllStaging = false;
+        config.Staging.EnableStreamingAssetsSync = false;
+        config.Staging.EnablePluginSanitize = false;
+        config.Loading.EnableNativeLibraries = false;
+        config.Security.AllowSymbolicLinks = false;
+    }
+
+    public static string Root => Path.GetFullPath(Required("GREGMODMANAGER_ROOT"));
+    private static string Session => Required("GREGMODMANAGER_SESSION");
+    private static string Ready
+    {
+        get
+        {
+            var path = Path.GetFullPath(Required("GREGMODMANAGER_READY"));
+            RejectLinkedAncestors(path);
+            var expected = Path.Combine(Root, "Configs", "runtime", Session + ".ready.json");
+            if (path != expected) throw new InvalidOperationException("Invalid readiness path.");
+            return path;
+        }
+    }
+
+    public static void SourcesReady()
+    {
+        if (!Enabled) return;
+        var path = Ready + ".sources.json";
+        File.WriteAllText(path + ".tmp", JsonSerializer.Serialize(new {
+            schemaVersion = 1, session = Session, managedSources = true }));
+        File.Move(path + ".tmp", path, true);
+    }
+
+    public static void RequireEarlyBootstrap()
+    {
+        if (!Enabled) return;
+        try
+        {
+            using var doc = JsonDocument.Parse(File.ReadAllText(Ready + ".sources.json"));
+            if (doc.RootElement.GetProperty("session").GetString() != Session
+                || !doc.RootElement.GetProperty("managedSources").GetBoolean())
+                throw new InvalidOperationException("Invalid early source acknowledgement.");
+        }
+        catch (Exception error) { Environment.FailFast("Managed mode requires pre-folder-scan Companion bootstrap.", error); }
+    }
+
+    public static IEnumerable<string> SafeDirectories(string root)
+    {
+        RejectLinkedAncestors(root);
+        if (!Directory.Exists(root)) yield break;
+        var pending = new Stack<string>();
+        pending.Push(root);
+        while (pending.Count != 0)
+        {
+            var path = pending.Pop();
+            var info = new DirectoryInfo(path);
+            if ((info.Attributes & FileAttributes.ReparsePoint) != 0)
+                throw new InvalidOperationException("Managed source contains a link: " + path);
+            foreach (var file in info.EnumerateFiles())
+                if ((file.Attributes & FileAttributes.ReparsePoint) != 0)
+                    throw new InvalidOperationException("Managed source contains a linked file: " + file.FullName);
+            yield return path;
+            foreach (var child in info.EnumerateDirectories().OrderBy(d => d.Name, StringComparer.Ordinal))
+                if (!child.Name.StartsWith('.') && !child.Name.EndsWith(".disabled", StringComparison.OrdinalIgnoreCase)) pending.Push(child.FullName);
+        }
+    }
+
+
+    private static void RejectLinkedAncestors(string path)
+    {
+        for (string? current = Path.GetFullPath(path); current != null; current = Path.GetDirectoryName(current))
+        {
+            try
+            {
+                if ((File.GetAttributes(current) & FileAttributes.ReparsePoint) != 0)
+                    throw new InvalidOperationException("Managed path contains a linked ancestor: " + current);
+            }
+            catch (FileNotFoundException) { }
+            catch (DirectoryNotFoundException) { }
+        }
+    }
+
+    private static string Required(string name) => Environment.GetEnvironmentVariable(name)
+        is { Length: > 0 } value ? value : throw new InvalidOperationException(name + " is required.");
+}
