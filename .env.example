# gregModmanager — Environment template
# Copy to `.env` (local) or inject into CI (GitHub Actions / Forgejo / Gitea
# secrets) as needed. NEVER commit real secrets — real values belong to the
# environment / CI secret store.

# ---------------------------------------------------------------------------
# Core application
# ---------------------------------------------------------------------------
# Set `1` to target local test services instead of production.
GREG_LOCAL_BUILD=0
GREG_LOCAL_TEST_BUILD=0

# Workspace / game roots (optional overrides).
GREG_WORKSPACE=
GREG_GAME_ROOT=

# Lint / tooling endpoint (optional).
GREG_LINT=

# ---------------------------------------------------------------------------
# Modstore (datacentermods.com) / auth
# ---------------------------------------------------------------------------
GREG_AUTH_URL=https://datacentermods.com/auth
GREG_MODSTORE_WEB_URL=https://datacentermods.com
GREG_MODSTORE_API_URL=https://datacentermods.com
GREG_MODSTORE_DISABLED=1

# ---------------------------------------------------------------------------
# Telemetry / Loki
# ---------------------------------------------------------------------------
GREG_TELEMETRY_ENABLED=0
GREG_LOKI_URL=http://localhost:3100/loki
GREG_LOKI_USER=
GREG_LOKI_PASS=
GREG_LOKI_TENANT=

# ---------------------------------------------------------------------------
# Background feeds
# ---------------------------------------------------------------------------
GREG_MELONLOADER_FEED_URL=https://github.com/LavaGang/MelonLoader/releases

# ---------------------------------------------------------------------------
# Universal Report Assistant — GitHub issue submission (direct channel)
# ---------------------------------------------------------------------------
# Enables the env-gated GitHub issue creation for the Report Assistant
# submission flow. When all three are set, a confirmed report is delivered as
# a GitHub issue via the GitHub Issues API (`POST /repos/{repo}/issues`).
# Unset / partial configuration keeps the local export delivery active.
# GREG_GITHUB_API_URL=https://api.github.com
# GREG_GITHUB_ISSUE_TARGET_REPO=teamGreg/gregModmanager
# GREG_GITHUB_TOKEN=
