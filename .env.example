# gregModmanager environment inventory — placeholders only, never real secrets.
# The Rust binaries do NOT load .env automatically. Export selected variables
# in the launching process; inject CI secrets explicitly into the relevant job.
# Blank optional overrides should normally remain UNSET: some readers treat an
# empty string as a configured value. Do not blindly export this entire file.
# Status: ACTIVE = read today; RESERVED = proposed integration contract only.
# See docs/ENVIRONMENT.md for deployment ownership and synchronization gaps.

# ACTIVE — desktop / CLI
GREG_LOCAL_BUILD=0
GREG_LOCAL_TEST_BUILD=0
RUST_LOG=info
# Optional paths; uncomment and set only when overriding discovery.
# GREG_WORKSPACE=/path/to/workspace
# GREG_GAME_ROOT=/path/to/game
GREG_MODSTORE_DISABLED=1
GREG_MODSTORE_WEB_URL=https://datacentermods.com
GREG_MODSTORE_API_URL=https://datacentermods.com
GREG_AUTH_URL=https://datacentermods.com/auth
GREG_MODSTORE_TOKEN=
GREG_MELONLOADER_FEED_URL=https://github.com/LavaGang/MelonLoader/releases
# Optional Steam Web API fallback for Workshop metadata / previews.
STEAM_WEB_API_KEY=
# Optional locale overrides (normally inherited from the OS).
# LC_ALL=de_DE.UTF-8
# LANG=de_DE.UTF-8

# ACTIVE — opt-in Loki sender. URL must include /loki/api/v1/push.
# GREG_LOCAL_BUILD=1 forces http://localhost:3100/loki/api/v1/push.
GREG_TELEMETRY_ENABLED=0
GREG_LOKI_URL=
GREG_LOKI_USER=
GREG_LOKI_PASS=
GREG_LOKI_TENANT=

# RESERVED — canonical Grafana / Loki deployment credentials.
# Mentioned by the former CI workflow; not read by the Rust sender.
# Until wired: map ENDPOINT -> GREG_LOKI_URL, USER -> GREG_LOKI_USER,
# API_KEY -> GREG_LOKI_PASS, TENANT -> GREG_LOKI_TENANT in the launcher.
# ENDPOINT is the complete Loki push URL, not the Grafana dashboard URL.
TELEMETRY_ENDPOINT=
TELEMETRY_USER=
TELEMETRY_API_KEY=
TELEMETRY_TENANT=

# ACTIVE — Report Assistant GitHub Issues channel (runtime credentials).
# API URL has a default; token + owner/repository enable direct submission.
GREG_GITHUB_API_URL=https://api.github.com
GREG_GITHUB_ISSUE_TARGET_REPO=
GREG_GITHUB_TOKEN=

# LEGACY — former Actions workflow notification. The current Jenkinsfile
# has no notification dispatcher; retain this name for migration compatibility.
DISCORD_WEBHOOK_URL=
# RESERVED — separate Discord embed destinations; no routing implemented yet.
# Public stable/full releases only; exclude prereleases and internal details.
RELEASE_DISCORD_WEBHOOK_URL=
# Internal workflow success / failure / cancelled status.
WORKFLOW_DISCORD_WEBHOOK_URL=
# Build durations, artifact sizes and platform build results.
BUILD_METRICS_DISCORD_WEBHOOK_URL=
# Coverage, lint, test and security summaries.
QUALITY_METRICS_DISCORD_WEBHOOK_URL=
# Aggregated crashes / errors; redact personal data and report contents.
ERROR_METRICS_DISCORD_WEBHOOK_URL=
# Aggregated usage / Loki alert summaries; preserve telemetry consent.
TELEMETRY_METRICS_DISCORD_WEBHOOK_URL=
# Sync backlog, retries, conflicts and failed deliveries.
SYNC_METRICS_DISCORD_WEBHOOK_URL=

# LEGACY — former Actions CI / release inputs; configure only when a job
# explicitly consumes them. Current Jenkins check/build matrix uses none.
# GITHUB_TOKEN was runner-provided in Actions; Forgejo used the same name.
# FORGEJO_TOKEN / GH_TOKEN were assigned by the former jobs.
GITHUB_TOKEN=
FORGEJO_TOKEN=
GH_TOKEN=
WINDOWS_SIGN_PFX_B64=
WINDOWS_SIGN_PASSWORD=
# Signing script reads CODE_SIGN_PFX_PASSWORD; path/thumbprint are wrapper
# conventions documented in build/installer/CODE_SIGNING.md.
CODE_SIGN_PFX=
CODE_SIGN_PFX_PASSWORD=
CODE_SIGN_THUMBPRINT=
# ACTIVE — optional local coverage helper.
CODACY_PROJECT_TOKEN=
# RESERVED / documented conventions: the current coverage wrapper does not
# explicitly read or forward these overrides; verify reporter support first.
# CODACY_API_BASE_URL=https://api.codacy.com
# CODACY_REPORTER_VERSION=<pinned-reporter-version>
# Remote macOS manual test helper (requires a configured SSH host).
MACOS_TEST_HOST=
# MACOS_TEST_DIR=~/gregModmanager-manual-test
MACOS_TEST_ARCH=arm64
# Gate inputs normally supplied by CI, not by the desktop app.
# STAGE=dev
# KIND=patch
NEEDS_REFS=false
DEV_COV=0
BASE_COV=0

# RESERVED — server-side GitHub mirror / synchronization service.
# Separate from the desktop Report Assistant token above.
GITHUB_API_URL=https://api.github.com
GITHUB_REPOSITORY=
GITHUB_SYNC_TOKEN=
GITHUB_WEBHOOK_SECRET=

# RESERVED — Bugsink ingestion and management / sync service.
# No Bugsink/Sentry reader exists in the active Rust workspace today.
# DSN is an ingestion address, NOT a management API token.
# Confirm API capabilities and webhook support against your deployed Bugsink.
BUGSINK_DSN=
SENTRY_DSN=
BUGSINK_BASE_URL=
BUGSINK_API_TOKEN=
BUGSINK_PROJECT_ID=
BUGSINK_WEBHOOK_SECRET=

# RESERVED in this repo — direct MantisNext report / sync client.
# Origin only; existing target route is /api/v1/issues (GET, POST).
# Create token in MantisNext account settings; Authorization: Bearer <token>.
# Token needs issues:read / issues:write and project membership/access.
MANTIS_NEXT_BASE_URL=
MANTIS_NEXT_API_TOKEN=
MANTIS_NEXT_PROJECT_ID=
# Optional UUIDs belonging to that project; omit if unused.
MANTIS_NEXT_CATEGORY_ID=
MANTIS_NEXT_VERSION_ID=
# Existing target receiver /api/webhooks/jenkins; client must send Bearer token.
MANTIS_NEXT_JENKINS_WEBHOOK_URL=

# ACTIVE on MantisNext web/worker ONLY, not consumed by gregModmanager.
# Configure the same Plane settings on the web service and integration worker.
PLANE_API_BASE_URL=https://api.plane.so
PLANE_WEB_BASE_URL=
PLANE_WORKSPACE_SLUG=
PLANE_API_KEY=
# Same receiver secrets must be configured at each sending provider.
PLANE_WEBHOOK_SECRET=
FORGEJO_WEBHOOK_SECRET=
JENKINS_WEBHOOK_TOKEN=
# True only after a separate persistent integrations:worker is deployed.
INTEGRATION_WORKER_ENABLED=false
# RESERVED: record intended Plane UUID for provisioning; actual MantisNext
# project mapping is stored via /integrations, not read from this variable.
PLANE_PROJECT_ID=

# RESERVED — shared bridge configuration for a future full mirror.
# Credentials alone do not implement synchronization; keep disabled for now.
ISSUE_SYNC_ENABLED=false
ISSUE_SYNC_DRY_RUN=true
# Versioned mapping: project/issue IDs, users, states, priorities and labels.
# Must also persist delivery IDs, checkpoints and conflict decisions durably.
ISSUE_SYNC_MAPPING_FILE=
ISSUE_SYNC_POLL_INTERVAL_SECONDS=60
ISSUE_SYNC_RETRY_LIMIT=5
# Proposed conflict policy: queue for review rather than overwrite silently.
ISSUE_SYNC_CONFLICT_POLICY=manual

# ACTIVE — generated per-child managed runtime handshake, not user secrets.
# The manager sets these only on a reviewed modded game process. Do not set
# them globally; each launch needs a fresh nonce/acknowledgement.
# GREGMODMANAGER_MANAGED=1
# GREGMODMANAGER_ROOT=/absolute/manager/base
# GREGMODMANAGER_SESSION=<generated-session-nonce>
# GREGMODMANAGER_READY=<base>/Configs/runtime/<nonce>.ready.json
# Legacy Companion source discovery (not the managed launch contract):
# GREGMODMANAGER_SOURCES=<platform-separated-source-roots>
