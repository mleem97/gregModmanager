<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <Color x:Key="SurfaceColor">#051424</Color>
    <Color x:Key="SurfaceContainerLowColor">#0D1C2D</Color>
    <Color x:Key="SurfaceContainerColor">#122131</Color>
    <Color x:Key="SurfaceContainerHighColor">#1C2B3C</Color>
    <Color x:Key="PrimaryColor">#8AEBFF</Color>
    <Color x:Key="SecondaryColor">#4DE082</Color>
    <Color x:Key="OnSurfaceColor">#D4E4FA</Color>
    <Color x:Key="OnSurfaceVariantColor">#BBC9CD</Color>
    <Color x:Key="OutlineVariantColor">#3C494C</Color>
    <Color x:Key="ErrorColor">#FFB4AB</Color>

    <SolidColorBrush x:Key="Surface" Color="{DynamicResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceContainerLow" Color="{DynamicResource SurfaceContainerLowColor}" />
    <SolidColorBrush x:Key="SurfaceContainer" Color="{DynamicResource SurfaceContainerColor}" />
    <SolidColorBrush x:Key="SurfaceContainerHigh" Color="{DynamicResource SurfaceContainerHighColor}" />
    <SolidColorBrush x:Key="Primary" Color="{DynamicResource PrimaryColor}" />
    <SolidColorBrush x:Key="Secondary" Color="{DynamicResource SecondaryColor}" />
    <SolidColorBrush x:Key="OnSurface" Color="{DynamicResource OnSurfaceColor}" />
    <SolidColorBrush x:Key="OnSurfaceVariant" Color="{DynamicResource OnSurfaceVariantColor}" />
    <SolidColorBrush x:Key="OutlineVariant" Color="{DynamicResource OutlineVariantColor}" />
    <SolidColorBrush x:Key="Error" Color="{DynamicResource ErrorColor}" />
  </Styles.Resources>

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource OnSurface}" />
    <Setter Property="FontFamily" Value="Inter" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
  </Style>

  <Style Selector="Border.titlebar">
    <Setter Property="Background" Value="#0A1A2A" />
    <Setter Property="BorderBrush" Value="#153245" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>

  <Style Selector="Border.accent-box">
    <Setter Property="Background" Value="{DynamicResource Primary}" />
    <Setter Property="BorderBrush" Value="#2BD9F4" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Border.sidebar">
    <Setter Property="Background" Value="#0A1B2C" />
    <Setter Property="BorderBrush" Value="#1A3245" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
  </Style>

  <Style Selector="Button.window-btn">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariant}" />
    <Setter Property="BorderBrush" Value="#2A3B49" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="11" />
  </Style>

  <Style Selector="Button.window-btn:pointerover">
    <Setter Property="Background" Value="#102B3A" />
    <Setter Property="Foreground" Value="{DynamicResource Primary}" />
  </Style>

  <Style Selector="Button.window-btn.close:pointerover">
    <Setter Property="Background" Value="#3C1B22" />
    <Setter Property="Foreground" Value="{DynamicResource Error}" />
  </Style>

  <Style Selector="Button.nav-item">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariant}" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="Button.nav-item.active">
    <Setter Property="Background" Value="#112B3F" />
    <Setter Property="BorderBrush" Value="#286C86" />
    <Setter Property="Foreground" Value="{DynamicResource OnSurface}" />
  </Style>

  <Style Selector="Border.panel">
    <Setter Property="Background" Value="#0E2032" />
    <Setter Property="BorderBrush" Value="#224258" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="14" />
  </Style>

  <Style Selector="Border.upload-zone">
    <Setter Property="MinHeight" Value="190" />
  </Style>

  <Style Selector="Border.security">
    <Setter Property="Padding" Value="14,10" />
  </Style>

  <Style Selector="Border.alert">
    <Setter Property="Background" Value="#2A1E24" />
    <Setter Property="BorderBrush" Value="#754A54" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="10,8" />
  </Style>

  <Style Selector="Border.status-chip">
    <Setter Property="Background" Value="#112435" />
    <Setter Property="BorderBrush" Value="#29485B" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="8,6" />
  </Style>

  <Style Selector="TextBox.input-terminal">
    <Setter Property="Background" Value="#05172A" />
    <Setter Property="BorderBrush" Value="#355265" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource OnSurface}" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="ComboBox.input-terminal">
    <Setter Property="Background" Value="#05172A" />
    <Setter Property="BorderBrush" Value="#355265" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource OnSurface}" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="TextBox.input-terminal:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource Secondary}" />
  </Style>

  <Style Selector="ComboBox.input-terminal:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource Secondary}" />
  </Style>

  <Style Selector="Button.btn-primary">
    <Setter Property="Background" Value="{DynamicResource Primary}" />
    <Setter Property="Foreground" Value="#062235" />
    <Setter Property="BorderBrush" Value="#8AEBFF" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Padding" Value="16,10" />
  </Style>

  <Style Selector="Button.btn-primary:pointerover">
    <Setter Property="Background" Value="#9EF0FF" />
  </Style>

  <Style Selector="TextBlock.headline">
    <Setter Property="FontFamily" Value="Inter" />
    <Setter Property="FontSize" Value="44" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <Style Selector="TextBlock.card-title">
    <Setter Property="FontSize" Value="30" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <Style Selector="TextBlock.subtext">
    <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariant}" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="TextBlock.alert-text">
    <Setter Property="Foreground" Value="{DynamicResource Error}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="TextBlock.micro-label">
    <Setter Property="FontFamily" Value="Consolas" />
    <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariant}" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <Style Selector="TextBlock.micro-label.cyan">
    <Setter Property="Foreground" Value="{DynamicResource Primary}" />
  </Style>

  <Style Selector="TextBlock.micro-label.green">
    <Setter Property="Foreground" Value="{DynamicResource Secondary}" />
  </Style>

  <Style Selector="TextBlock.mono-data, TextBlock.chip-text">
    <Setter Property="FontFamily" Value="Consolas" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariant}" />
  </Style>

  <Style Selector="Ellipse.led">
    <Setter Property="Fill" Value="#546D79" />
  </Style>

  <Style Selector="Ellipse.led-ok">
    <Setter Property="Fill" Value="{DynamicResource Secondary}" />
  </Style>

  <Style Selector="Ellipse.led-ring">
    <Setter Property="Stroke" Value="{DynamicResource Secondary}" />
    <Setter Property="StrokeThickness" Value="2" />
    <Setter Property="Fill" Value="#153A34" />
  </Style>
</Styles>
