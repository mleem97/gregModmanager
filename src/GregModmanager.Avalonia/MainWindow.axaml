<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GregModmanager.Avalonia.ViewModels"
        x:Class="GregModmanager.Avalonia.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1400"
        Height="900"
        MinWidth="1024"
        MinHeight="640"
        Background="{DynamicResource Surface}"
        SystemDecorations="None"
        Title="gregModmanager">
  <Grid RowDefinitions="42,*" ColumnDefinitions="240,*">
    <Border Grid.Row="0"
            Grid.ColumnSpan="2"
            Classes="titlebar"
            PointerPressed="OnTitleBarPointerPressed">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Margin="14,0,0,0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Spacing="8">
          <Border Width="18"
                  Height="18"
                  CornerRadius="2"
                  Classes="accent-box" />
          <TextBlock Classes="micro-label"
                     Text="GREGMODMANAGER // TERMINAL CORE" />
        </StackPanel>

        <StackPanel Grid.Column="1"
                    Margin="0,4,6,4"
                    Orientation="Horizontal"
                    Spacing="4">
          <Button Width="34"
                  Height="28"
                  Classes="window-btn"
                  Content="□"
                  Click="OnMaximizeClicked" />
          <Button Width="34"
                  Height="28"
                  Classes="window-btn"
                  Content="—"
                  Click="OnMinimizeClicked" />
          <Button Width="34"
                  Height="28"
                  Classes="window-btn close"
                  Content="✕"
                  Click="OnCloseClicked" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1" Grid.Column="0" Classes="sidebar">
      <Grid Margin="10,14,10,10" RowDefinitions="Auto,*,Auto">
        <StackPanel x:Name="NavPanel" Spacing="6">
          <TextBlock Classes="micro-label cyan" Text="MODMANAGER" />
          <Button x:Name="BtnProjects" Classes="nav-item active" Content="Projects" Click="OnNavProjects" />
          <Button x:Name="BtnNewProject" Classes="nav-item" Content="New Project" Click="OnNavNewProject" />
          <Button x:Name="BtnMyUploads" Classes="nav-item" Content="My Uploads" Click="OnNavMyUploads" />
          <TextBlock Classes="micro-label cyan" Margin="0,12,0,0" Text="MODSTORE" />
          <Button x:Name="BtnModStore" Classes="nav-item" Content="Mod Store" Click="OnNavModStore" IsVisible="False" />
          <TextBlock Classes="micro-label" Margin="0,12,0,0" Text="SYSTEM" />
          <Button x:Name="BtnSettings" Classes="nav-item" Content="Settings" Click="OnNavSettings" />
        </StackPanel>

        <StackPanel Grid.Row="2" Spacing="8">
          <Button x:Name="LoginButton" Classes="profile-card" Click="OnLoginClicked">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Border Width="36" Height="36" CornerRadius="18" Background="#17364A">
                <TextBlock Text="→" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="LoginPromptLabel" FontWeight="Bold" />
                <TextBlock x:Name="LoginPromptHint" Classes="subtext" />
              </StackPanel>
            </StackPanel>
          </Button>

          <Button x:Name="ProfileButton" Classes="profile-card" Click="OnProfileButtonClicked" IsVisible="False">
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
              <Border Width="38" Height="38" CornerRadius="19" Background="#17364A" Grid.RowSpan="2">
                <Grid>
                  <Image x:Name="ProfileImage" Stretch="UniformToFill" IsVisible="False" />
                  <TextBlock x:Name="ProfileInitials" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
              </Border>
              <TextBlock x:Name="ProfileNameText" Grid.Column="1" Margin="10,0,0,0" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
              <TextBlock x:Name="ProfileRoleText" Grid.Column="1" Grid.Row="1" Margin="10,2,0,0" Classes="subtext" />
            </Grid>
          </Button>

          <Border Classes="status-chip">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Ellipse x:Name="SteamStatusLed" Width="8" Height="8" />
              <TextBlock x:Name="SteamStatusText" Classes="chip-text" Text="Steam Disconnected" />
            </StackPanel>
          </Border>

          <Border Classes="status-chip">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Ellipse x:Name="GregApiStatusLed" Width="8" Height="8" />
              <TextBlock x:Name="GregApiStatusText" Classes="chip-text" Text="gregAPI Offline" />
            </StackPanel>
          </Border>

          <Border Classes="status-chip">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Ellipse x:Name="AuthStatusLed" Width="8" Height="8" />
              <TextBlock x:Name="AuthStatusText" Classes="chip-text" Text="Login To Datacentermods.com" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource Surface}" Padding="4">
      <ContentControl x:Name="MainContent"
                      HorizontalContentAlignment="Stretch"
                      VerticalContentAlignment="Stretch" />
    </Border>

    <Popup x:Name="ProfileMenu" IsLightDismissEnabled="True" Placement="Top">
      <Border Classes="profile-menu">
        <StackPanel Spacing="4">
          <TextBlock x:Name="ProfileMenuHeader" Classes="micro-label cyan" />
          <Button x:Name="ProfileMenuProfile" Classes="profile-menu-item" Click="OnShowProfileClicked" />
          <Button x:Name="ProfileMenuMods" Classes="profile-menu-item" Click="OnMyModsClicked" />
          <Button x:Name="ProfileMenuUpload" Classes="profile-menu-item" Click="OnUploadModClicked" />
          <Button x:Name="ProfileMenuSettings" Classes="profile-menu-item" Click="OnProfileSettingsClicked" />
          <Separator Margin="0,4" />
          <Button x:Name="ProfileMenuLogout" Classes="profile-menu-item danger" Click="OnLogoutClicked" />
        </StackPanel>
      </Border>
    </Popup>
  </Grid>
</Window>
