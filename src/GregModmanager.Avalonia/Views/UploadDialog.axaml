<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GregModmanager.Avalonia.Views.UploadDialog"
        Title="Workshop Upload" Width="560" Height="420"
        MinWidth="480" MinHeight="340"
        CanResize="True"
        WindowDecorations="None"
        WindowStartupLocation="CenterOwner"
        Classes="dialog-window">
  <Grid RowDefinitions="42,*,Auto">
    <Border Classes="titlebar">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
          <Border Width="12" Height="12" CornerRadius="2" Classes="accent-box" />
          <TextBlock Text="DIALOG // WORKSHOP UPLOAD" VerticalAlignment="Center" Classes="micro-label cyan" />
        </StackPanel>
        <Button Grid.Column="1" x:Name="TitleCloseButton" Content="✕" Width="34" Height="28"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                Classes="window-btn close" Click="OnCloseClicked" />
      </Grid>
    </Border>

    <StackPanel Grid.Row="1" Classes="dialog-body" Spacing="8">
      <TextBlock x:Name="TitleLabel" Text="Workshop Upload" Classes="headline" />
      <TextBlock x:Name="StatusLabel" Classes="subtext" TextWrapping="Wrap" />

      <ProgressBar x:Name="ProgressBar"
                   Minimum="0" Maximum="1" Value="0"
                   Height="14" Margin="0,4,0,4" />

      <Border Classes="panel">
        <ScrollViewer x:Name="LogScroller" VerticalScrollBarVisibility="Auto" MaxHeight="220">
          <ItemsControl x:Name="LogList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" Classes="subtext" TextWrapping="Wrap" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>
    </StackPanel>

    <StackPanel Grid.Row="2" Orientation="Horizontal"
                HorizontalAlignment="Right" Spacing="8" Margin="18,0,18,18">
      <Button x:Name="CancelButton" Content="Cancel" Classes="btn-primary" Click="OnCancelClicked" />
      <Button x:Name="CloseButton" Content="Close" Classes="dialog-secondary" IsVisible="False" Click="OnCloseClicked" />
    </StackPanel>
  </Grid>
</Window>
