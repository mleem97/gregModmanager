# escape=`
# Build this file only with Docker switched to Windows containers on a compatible Windows host.
FROM mcr.microsoft.com/dotnet/runtime:9.0-windowsservercore-ltsc2022 AS runtime9
FROM mcr.microsoft.com/dotnet/sdk:10.0-windowsservercore-ltsc2022 AS build
SHELL ["powershell", "-NoProfile", "-Command", "$ErrorActionPreference = 'Stop'; $ProgressPreference = 'SilentlyContinue';"]
WORKDIR C:\src

# The projects target net9.0 while global.json selects SDK 10. Copy the matching
# runtime into the SDK image so the test stage can execute net9.0 test binaries.
COPY --from=runtime9 ["C:\\Program Files\\dotnet\\shared\\Microsoft.NETCore.App\\", "C:\\Program Files\\dotnet\\shared\\Microsoft.NETCore.App\\"]

COPY . .
RUN dotnet restore GregModmanager.sln; `
    dotnet build GregModmanager.sln --no-restore --configuration Release

FROM build AS test
RUN dotnet test GregModmanager.sln --no-build --configuration Release --verbosity normal

FROM build AS publish
RUN dotnet publish src\GregModmanager.Avalonia\GregModmanager.Avalonia.csproj `
      --configuration Release --runtime win-x64 --self-contained true --no-restore `
      --output C:\out\win-x64
